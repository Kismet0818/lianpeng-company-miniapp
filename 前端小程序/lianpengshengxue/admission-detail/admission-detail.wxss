page {
  background: linear-gradient(180deg, #0f3460 0%, #143c6c 15%, #2a4e77 35%);
  color: #222;
}

.page {
  min-height: 100vh;
}

/* ===== 顶部学校信息 ===== */
.hero {
  background: #0f3460;
  padding: 32rpx 36rpx 40rpx;
  border-radius: 0 0 32rpx 32rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.12);
}

.hero-row {
  display: flex;
  align-items: center;
}

.hero-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #fff;
  flex-shrink: 0;
}

.hero-logo-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: rgba(255,255,255,.15);
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-info {
  margin-left: 24rpx;
  flex: 1;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.hero-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.hero-tag {
  font-size: 22rpx;
  color: #fff;
  background: #607fa3;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,.6);
}

/* ===== 招生进度（背景融合） ===== */
.progress-section {
  padding: 36rpx 36rpx 32rpx;
  background: linear-gradient(180deg, #143c6c 0%, #1d457a 40%, #2a4e77 100%);
}

.progress-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255,255,255,.95);
}

.progress-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e6c87a;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.progress-content {
  margin-bottom: 24rpx;
}

.progress-text {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,.85);
  line-height: 44rpx;
}

.tag-scroll {
  width: 100%;
  white-space: nowrap;
}

.tag-item {
  display: inline-block;
  font-size: 24rpx;
  color: rgba(255,255,255,.85);
  border: 2rpx solid rgba(255,255,255,.3);
  border-radius: 32rpx;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
}

/* ===== 白色卡片 ===== */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 36rpx 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06);
}

.card:first-of-type {
  margin-top: 8rpx;
}

.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.card-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e6c87a;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.card-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.card-row:last-child {
  margin-bottom: 0;
}

.card-label {
  font-size: 26rpx;
  color: #666;
  width: 150rpx;
  flex-shrink: 0;
}

.card-value {
  font-size: 26rpx;
  color: #222;
  flex: 1;
}

.card-highlight {
  color: #d66060;
  font-weight: 600;
}

/* ===== 底部悬浮栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06);
  box-sizing: border-box;
  z-index: 100;
}

.bar-icons {
  display: flex;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.bar-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}

.bar-icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: 0;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: inherit;
}

.bar-icon-btn::after {
  border: 0;
}

.bar-icon-text {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.bar-icon-label {
  font-size: 20rpx;
  color: #666;
}

.bar-btns {
  display: flex;
  flex: 1;
  gap: 16rpx;
}

.bar-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.bar-btn-primary {
  background: #0f3460;
  color: #fff;
}

.bar-btn-yellow {
  background: #fce94f;
  color: #222;
}
