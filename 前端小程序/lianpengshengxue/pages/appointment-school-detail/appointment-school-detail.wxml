<view class="page"><view wx:if="{{loading}}" class="state"><view class="loader"></view><text>正在整理学校档案</text></view><view wx:elif="{{error}}" class="state"><text>暂时无法打开这所学校的档案</text><button bindtap="goBack">返回学校列表</button></view><block wx:else><view class="topbar"><view class="back" bindtap="goBack">‹</view><text>学校档案</text><view class="top-action" bindtap="toggleFavorite">{{favorite ? '已收藏' : '收藏'}}</view></view><view class="hero"><view class="hero-kicker">{{school.level}} · {{school.tier || '重点学校'}}</view><view class="hero-title">{{school.name}}</view><view class="hero-sub">{{school.shortName || school.schoolType || '上海基础教育学校'}}</view><view class="hero-rule"></view><view class="hero-meta"><text>{{school.district}}</text><text wx:if="{{school.foundedYear}}">建校 {{school.foundedYear}}</text><text wx:if="{{school.boardingInfo}}">{{school.boardingInfo}}</text></view></view><view class="quick-grid"><view class="quick-item" bindtap="openMap"><image class="quick-icon" src="/assets/icons/xuexiaoku/dingweihei.png" mode="aspectFit"></image><view class="quick-copy"><text class="quick-label">地址</text><text class="quick-value">{{school.address || '暂无地址'}}</text><text class="quick-link">查看地图</text></view></view></view><view class="section" wx:if="{{school.description}}"><view class="section-head"><text>学校概览</text></view><text class="body-copy">{{school.description}}</text></view><view class="section" wx:if="{{school.teachingFeatures || school.featuresCourses}}"><view class="section-head"><text>办学与课程</text></view><view wx:if="{{school.teachingFeatures}}" class="data-block"><text class="data-label">教学特色</text><text class="body-copy">{{school.teachingFeatures}}</text></view><view wx:if="{{school.featuresCourses}}" class="data-block"><text class="data-label">特色课程</text><text class="body-copy">{{school.featuresCourses}}</text></view></view><view class="section" wx:if="{{school.facultyStrength || school.foreignSituation || school.competitionResult}}"><view class="section-head"><text>学校实力</text></view><view wx:if="{{school.facultyStrength}}" class="data-block"><text class="data-label">师资力量</text><text class="body-copy">{{school.facultyStrength}}</text></view><view wx:if="{{school.foreignSituation}}" class="data-block"><text class="data-label">国际交流</text><text class="body-copy">{{school.foreignSituation}}</text></view><view wx:if="{{school.competitionResult}}" class="data-block"><text class="data-label">办学成果</text><text class="body-copy">{{school.competitionResult}}</text></view></view><view class="section" wx:if="{{school.enrollmentTarget || school.enrollmentPlanning || school.enrollmentWay}}"><view class="section-head"><text>招生信息</text></view><view class="admission-row" wx:if="{{school.enrollmentYear}}"><text>招生年度</text><text>{{school.enrollmentYear}}</text></view><view class="admission-row" wx:if="{{school.enrollmentTarget}}"><text>招生对象</text><text>{{school.enrollmentTarget}}</text></view><view class="admission-row" wx:if="{{school.enrollmentPlanning}}"><text>招生计划</text><text>{{school.enrollmentPlanning}}</text></view><view class="admission-row" wx:if="{{school.enrollmentWay}}"><text>招生方式</text><text>{{school.enrollmentWay}}</text></view></view><view class="section" wx:if="{{school.feesStandard || school.tuitionMin || school.tuitionMax}}"><view class="section-head"><text>费用与服务</text></view><view class="admission-row" wx:if="{{school.feesStandard}}"><text>收费标准</text><text>{{school.feesStandard}}</text></view><view class="admission-row" wx:if="{{school.tuitionMin || school.tuitionMax}}"><text>学费区间</text><text>{{school.tuitionMin || '—'}} - {{school.tuitionMax || '—'}}</text></view><view class="admission-row" wx:if="{{school.isBus}}"><text>校车</text><text>{{school.isBus}}</text></view></view><view class="section last-section"><view class="section-head"><text>预约前提示</text></view><text class="body-copy">页面信息来自学校资料库，招生计划、开放日和收费安排可能随年度政策调整。提交预约后，会有老师与您确认具体时间。</text></view></block></view><view wx:if="{{!loading && !error}}" class="bottom"><view class="bottom-favorite" bindtap="toggleFavorite">{{favorite ? '★' : '☆'}}<text>收藏</text></view><button bindtap="reserve">预约探校</button></view>
