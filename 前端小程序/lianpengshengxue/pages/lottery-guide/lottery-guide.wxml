<view class="page"><view class="topbar" style="height:{{navBarHeight}}px"><view class="back-button" style="top:{{menuTop}}px;height:{{menuHeight}}px" bindtap="goBack" aria-label="返回"><view class="back-arrow"></view></view><text class="nav-title" style="top:{{menuTop}}px;height:{{menuHeight}}px;line-height:{{menuHeight}}px">摇号指南</text></view><view class="hero"><text class="hero-title">摇号指南</text><text class="hero-sub">上海幼升小、小升初摇号政策与实操解读</text></view><view wx:if="{{loading}}" class="status">正在加载内容...</view><view wx:elif="{{error}}" class="status error">{{error}}<text bindtap="load">重新加载</text></view><view wx:elif="{{articles.length}}" class="list"><text class="count">共找到{{total}}篇</text><view wx:for="{{articles}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openArticle"><view class="card-copy"><view class="title">{{item.title}}</view><text class="summary">{{item.summary || '整理上海幼升小、小升初摇号政策、流程与家长常见问题。'}}</text><text class="meta">{{item.publishedAt || ''}}</text></view><image class="cover" src="{{item.coverImageUrl || '/assets/icons/zixun.png'}}" mode="aspectFill" /></view></view><view wx:else class="status">暂无摇号指南内容</view></view>
