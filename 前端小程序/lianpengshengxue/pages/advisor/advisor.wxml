<view class="advisor-page"><view class="advisor-head" style="padding-top:{{navTop}}px;"><view class="custom-nav" style="height:{{navHeight}}px;"><view class="back-button" bindtap="goBack" aria-label="返回"><view class="back-arrow"></view></view><text class="nav-title">智能升学顾问</text></view><view class="head-copy"><text class="head-sub">规则驱动的初步择校助手</text></view></view><scroll-view class="chat" scroll-y><view class="notice">推荐用于初步筛选，请以学校最新招生政策为准</view><view wx:for="{{messages}}" wx:key="index" class="message {{item.role}}"><text>{{item.text}}</text></view><view wx:if="{{loading}}" class="loading">顾问正在整理信息…</view><view wx:if="{{error}}" class="error">{{error}} <text bindtap="retry">重试</text></view><view wx:if="{{schools.length}}" class="results"><text class="result-title">为你推荐</text><view wx:for="{{schools}}" wx:for-item="school" wx:key="schoolId" class="school-card" data-item="{{school}}" bindtap="onSchoolTap"><image wx:if="{{school.logoUrl}}" src="{{school.logoUrl}}" mode="aspectFit"></image><view><text>{{school.name}}</text><text>{{school.district}} · {{school.schoolType}}</text></view><text>›</text></view></view><view class="choices" wx:if="{{choices.length && !schools.length}}"><button wx:for="{{choices}}" wx:key="value" data-value="{{item.value}}" data-label="{{item.label}}" bindtap="onChoice">{{item.label}}</button></view></scroll-view><view class="composer"><input value="{{input}}" maxlength="200" placeholder="也可以直接输入你的需求" confirm-type="send" bindinput="onInput" bindconfirm="onConfirm"/><button bindtap="onConfirm">发送</button></view></view>
