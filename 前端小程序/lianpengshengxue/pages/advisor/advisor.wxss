page{background:#f4f8fa}.advisor-page{min-height:100vh;padding-bottom:120rpx;box-sizing:border-box;background:#f4f8fa}.advisor-head{padding:32rpx 28rpx;color:#fff;background:linear-gradient(135deg,#4d92bb,#64a8cd 62%,#91c9e3)}.head-title{display:block;font-size:36rpx;font-weight:700}.head-sub{display:block;margin-top:6rpx;color:rgba(255,255,255,.82);font-size:22rpx}.chat{height:calc(100vh - 250rpx);padding:24rpx;box-sizing:border-box}.notice{margin-bottom:20rpx;color:#78909b;font-size:21rpx;text-align:center}.message{display:flex;margin:14rpx 0}.message text{max-width:78%;padding:18rpx 22rpx;color:#3e535e;background:#fff;border-radius:8rpx 22rpx 22rpx;line-height:38rpx}.message.user{justify-content:flex-end}.message.user text{color:#fff;background:#64a8cd;border-radius:22rpx 8rpx 22rpx}.loading,.error{margin:18rpx 0;color:#8b9aa2;font-size:23rpx}.error text{margin-left:16rpx;color:#4d92bb}.choices{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:22rpx}.choices button,.contact button{margin:0;padding:0 24rpx;height:66rpx;line-height:66rpx;color:#397fa8;background:#e8f5fa;border:1rpx solid #b9ddea;border-radius:34rpx;font-size:25rpx}.choices button::after,.contact button::after,.composer button::after{border:0}.results{margin-top:24rpx}.result-title{display:block;margin-bottom:12rpx;color:#344952;font-size:28rpx;font-weight:700}.school-card{display:flex;align-items:center;gap:14rpx;margin-bottom:12rpx;padding:16rpx;background:#fff;border-radius:16rpx}.school-card image{width:72rpx;height:72rpx}.school-card view{min-width:0;flex:1}.school-card view text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.school-card view text:first-child{color:#344952;font-size:26rpx}.school-card view text:last-child{margin-top:8rpx;color:#8b9aa2;font-size:21rpx}.contact{margin-top:24rpx;padding:20rpx;text-align:center;background:#fff;border-radius:16rpx}.contact text{display:block;margin-bottom:14rpx;color:#607785;font-size:24rpx}.contact button{display:inline-block;color:#fff;background:#4d92bb}.composer{position:fixed;left:0;right:0;bottom:0;z-index:10;display:flex;gap:12rpx;padding:16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.94);border-top:1rpx solid #e1edf2}.composer input{min-width:0;flex:1;height:70rpx;padding:0 22rpx;box-sizing:border-box;background:#f2f6f8;border-radius:35rpx;font-size:24rpx}.composer button{width:108rpx;height:70rpx;margin:0;padding:0;line-height:70rpx;color:#fff;background:#4d92bb;border-radius:35rpx;font-size:24rpx}
.custom-nav{position:relative;display:flex;align-items:center;justify-content:center}.nav-title{font-size:36rpx;font-weight:700;line-height:44px}.back-button{position:absolute;left:0;bottom:0;width:80rpx;height:44px;display:flex;align-items:center;justify-content:flex-start}.back-arrow{width:22rpx;height:22rpx;margin-left:10rpx;border-left:4rpx solid #fff;border-bottom:4rpx solid #fff;transform:rotate(45deg)}.head-copy{padding:8rpx 0 28rpx}.head-sub{display:block;margin-top:0}
