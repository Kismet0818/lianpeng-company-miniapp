page { background:#f4f7f9; color:#263942; }
.page { min-height:100vh; }
.hero { padding:35rpx 28rpx 39rpx; color:#fff; background:linear-gradient(145deg,#397fa8,#64a8cd 58%,#91c9e3); border-radius:0 0 28rpx 28rpx; box-shadow:0 9rpx 24rpx rgba(45,105,137,.16); }
.hero-en { display:block; color:rgba(255,255,255,.7); font-size:17rpx; letter-spacing:3rpx; }
.hero-title { display:block; margin-top:9rpx; font-size:40rpx; line-height:54rpx; font-weight:800; }
.hero-sub { display:block; margin-top:12rpx; color:rgba(255,255,255,.88); font-size:23rpx; line-height:36rpx; }
.hero-tags { display:flex; margin-top:20rpx; }
.hero-tags text { margin-right:10rpx; padding:6rpx 16rpx; background:rgba(255,255,255,.18); border:1rpx solid rgba(255,255,255,.4); border-radius:23rpx; font-size:19rpx; }
.summary-card,.content-section,.cta-card { margin:22rpx 20rpx 0; padding:24rpx 22rpx; background:#fff; border:1rpx solid #e1e9ed; border-radius:20rpx; box-shadow:0 6rpx 20rpx rgba(44,80,98,.07); }
.section-title { display:flex; align-items:center; }
.section-title > view { width:7rpx; height:32rpx; margin-right:11rpx; background:#64a8cd; border-radius:4rpx; }
.section-title > text { font-size:30rpx; font-weight:700; }
.summary-copy,.section-note { display:block; margin-top:16rpx; color:#718188; font-size:22rpx; line-height:36rpx; }
.change-grid { display:flex; margin-top:20rpx; background:#eef7fb; border-radius:15rpx; }
.change-grid view { flex:1; padding:15rpx 5rpx; text-align:center; }
.change-grid view + view { border-left:1rpx solid #d6e9f1; }
.change-grid text:first-child { display:block; color:#4d92bb; font-size:19rpx; font-weight:700; }
.change-grid text:last-child { display:block; margin-top:5rpx; color:#65777f; font-size:17rpx; }
.subject-card { margin-top:19rpx; padding:20rpx; background:linear-gradient(150deg,#f7fcfe,#edf7fb); border:1rpx solid #d9ebf2; border-radius:17rpx; }
.subject-cyan { background:linear-gradient(150deg,#f7fcfd,#edf8f8); }
.subject-teal { background:linear-gradient(150deg,#f6fcfb,#edf8f5); }
.subject-head { display:flex; align-items:flex-end; justify-content:space-between; }
.subject-head > view text:first-child { display:block; color:#8eb2c4; font-size:15rpx; letter-spacing:2rpx; }
.subject-head > view text:last-child { display:block; margin-top:3rpx; color:#294b5b; font-size:29rpx; font-weight:700; }
.subject-number { color:#cbe5f0; font-size:38rpx; font-weight:800; }
.subject-desc { display:block; margin-top:13rpx; color:#718188; font-size:21rpx; line-height:34rpx; }
.point-list { margin-top:12rpx; }
.point-list view { padding:6rpx 0; color:#536870; font-size:20rpx; }
.point-list text { margin-right:8rpx; color:#64a8cd; font-weight:700; }
.score-chart { overflow:hidden; margin-top:16rpx; padding:16rpx; background:#fff; border:1rpx solid #dceaf0; border-radius:14rpx; }
.score-chart > text { display:block; margin-bottom:12rpx; color:#31576a; font-size:22rpx; font-weight:700; }
.score-chart image { width:100%; height:auto; display:block; border-radius:10rpx; }
.timeline { margin-top:20rpx; }
.timeline-item { display:flex; }
.timeline-axis { position:relative; width:35rpx; flex-shrink:0; }
.timeline-axis view { position:relative; z-index:2; width:17rpx; height:17rpx; margin:8rpx auto 0; background:#64a8cd; border:5rpx solid #dceff7; border-radius:50%; box-sizing:border-box; }
.timeline-axis text { position:absolute; top:22rpx; bottom:-8rpx; left:17rpx; border-left:2rpx dotted #a9d3e5; }
.timeline-item:last-child .timeline-axis text { display:none; }
.timeline-copy { padding:0 0 24rpx 8rpx; }
.timeline-copy text:first-child { display:block; color:#31576a; font-size:24rpx; font-weight:700; }
.timeline-copy text:last-child { display:block; margin-top:7rpx; color:#77878e; font-size:20rpx; line-height:32rpx; }
.cta-card { color:#fff; background:linear-gradient(135deg,#397fa8,#64a8cd 62%,#91c9e3); }
.cta-title { display:block; font-size:30rpx; font-weight:700; }
.cta-copy { display:block; margin-top:10rpx; color:rgba(255,255,255,.86); font-size:22rpx; line-height:35rpx; }
.cta-button { height:66rpx; display:flex; align-items:center; justify-content:center; margin-top:20rpx; color:#397fa8; background:#fff; border-radius:34rpx; font-size:24rpx; font-weight:700; }
.bottom-space { height:150rpx; }
.bottom-bar { position:fixed; left:0; right:0; bottom:0; z-index:100; display:flex; align-items:center; padding:16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); background:rgba(255,255,255,.97); border-top:1rpx solid #dce7ec; box-shadow:0 -5rpx 18rpx rgba(44,80,98,.07); }
.bottom-bar > view:first-child { min-width:0; flex:1; }
.bottom-bar > view:first-child text:first-child { display:block; font-size:23rpx; font-weight:700; }
.bottom-bar > view:first-child text:last-child { display:block; margin-top:3rpx; color:#8a989f; font-size:18rpx; }
.bottom-button { flex-shrink:0; margin-left:16rpx; padding:18rpx 28rpx; color:#fff; background:#ff554b; border-radius:34rpx; font-size:24rpx; font-weight:700; }
