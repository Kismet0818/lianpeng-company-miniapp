page{background:#f5f7fa;color:#273746}.page{padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}
.header{background:#eaf4fa;padding:34rpx 28rpx 30rpx}.heading{font-size:36rpx;font-weight:600}.caption{font-size:23rpx;color:#79909f;margin-top:12rpx}
.search{display:flex;align-items:center;background:#fff;border-radius:12rpx;height:82rpx;margin-top:28rpx;padding:0 24rpx}.search input{flex:1;min-width:0;font-size:27rpx;height:100%}.placeholder{color:#a2adb7}.search-icon{width:23rpx;height:23rpx;border:3rpx solid #91a3af;border-radius:50%;margin-right:22rpx;position:relative}.search-icon:after{content:'';position:absolute;width:11rpx;height:3rpx;background:#91a3af;right:-8rpx;bottom:-4rpx;transform:rotate(45deg)}.clear{padding:16rpx;color:#8a99a4;font-size:36rpx}
.categories{display:flex;padding:26rpx 20rpx 22rpx;background:#fff;gap:8rpx}.category{flex:1;min-width:0;text-align:center;padding:16rpx 0;border-radius:14rpx;border:2rpx solid transparent}.category.selected{background:#edf6fb;border-color:#c3deed}.category-mark{margin:0 auto 12rpx;width:66rpx;height:66rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;background:#f1f6f9}.category-mark image{width:42rpx;height:42rpx;display:block}.selected .category-mark{background:#dceef7}.selected .category-mark image{width:46rpx;height:46rpx}.category-name{display:block;font-size:25rpx;font-weight:600;white-space:nowrap}.category-note{display:block;font-size:18rpx;color:#8e9ca6;margin-top:8rpx;white-space:nowrap}
.list-header{display:flex;align-items:center;padding:30rpx 28rpx 22rpx}.section-title{font-size:30rpx;font-weight:600}.count{font-size:22rpx;color:#98a4ad;margin-left:16rpx}
.file-list{margin:0 24rpx;background:#fff;border-radius:18rpx;padding:0 24rpx}.file{display:flex;align-items:center;gap:22rpx;padding:28rpx 0;border-bottom:1rpx solid #eff2f5}.file:last-child{border-bottom:0}.file-icon{flex-shrink:0;width:70rpx;height:88rpx;box-sizing:border-box;border:1rpx solid #c6dfe9;background:#eff7fb;border-radius:7rpx;color:#5995b5;text-align:center;padding-top:12rpx}.file-icon text{font-size:20rpx;font-weight:600}.file-icon view{width:36rpx;height:3rpx;background:currentColor;opacity:.25;margin:8rpx auto}.file-icon.paper{background:#eff5f3;border-color:#d5e5df;color:#6b9786}.file-icon.template{background:#faf5ec;border-color:#eee0c9;color:#b49969}.file-content{flex:1;min-width:0}.file-title{display:block;font-size:28rpx;line-height:42rpx;font-weight:500;word-break:break-all}.file-meta{display:block;font-size:22rpx;color:#91a0aa;margin-top:10rpx;line-height:32rpx}.file-category{display:inline-block;font-size:19rpx;color:#7893a4;background:#f3f7fa;border-radius:5rpx;padding:3rpx 10rpx;margin-top:10rpx}.arrow{color:#b8c4cb;font-size:34rpx}
.status{display:flex;align-items:center;justify-content:center;gap:16rpx;padding:46rpx 20rpx;color:#8f9da7;font-size:24rpx}.loading-dot{width:22rpx;height:22rpx;border:3rpx solid #dae8f0;border-top-color:#64a8cd;border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.retry{color:#4d92bb;padding:14rpx;font-size:25rpx}.empty{display:flex;align-items:center;flex-direction:column;gap:16rpx;padding:90rpx 24rpx;color:#97a4ae;font-size:24rpx}.empty-title{font-size:29rpx;color:#647887}.end{padding:40rpx;text-align:center;font-size:22rpx;color:#a9b3ba}
