<view class="page">
  <view class="hero" style="padding-top:{{safeTop}}px;"><view class="hero-shape shape-one"></view><view class="hero-shape shape-two"></view><view class="nav-row"><view class="back-button" bindtap="goBack"><view class="back-arrow"></view></view><text class="nav-title">{{mode === 'policy' ? '查政策' : '查对口'}}</text></view><view class="hero-body"><text class="hero-title">{{mode === 'policy' ? '升学政策' : '26年对口方案'}}</text><text class="hero-sub">{{mode === 'policy' ? '上海升学政策、报考指南与最新资讯' : '2026年上海16区幼、小、初最新地段对口方案'}}</text></view></view>
  <view class="district-panel"><scroll-view class="district-tabs" scroll-x enhanced show-scrollbar="{{false}}"><view class="district-tab {{selected === '' ? 'active' : ''}}" data-district="" bindtap="selectDistrict">全部</view><view class="district-tab {{selected === item.name ? 'active' : ''}}" wx:for="{{districts}}" wx:key="name" data-district="{{item.name}}" bindtap="selectDistrict">{{item.name}}</view></scroll-view></view>
  <view class="status" wx:if="{{loading}}"><view class="loading-dot"></view><text>{{mode === 'policy' ? '正在加载政策资料...' : '正在加载对口资料...'}}</text></view>
  <view class="status error" wx:elif="{{error}}"><text>{{error}}</text><view class="retry" bindtap="loadAll">重新加载</view></view>
  <view class="material-list" wx:elif="{{visibleItems.length}}"><view class="material-card" wx:for="{{visibleItems}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail"><view class="card-main"><text class="card-title">{{item.title}}</text><text class="card-summary" wx:if="{{item.summary}}">{{item.summary}}</text><text class="card-summary placeholder" wx:else>{{mode === 'policy' ? '政策内容整理中，点击查看完整内容' : '对口方案整理中，点击查看完整内容'}}</text></view><view class="card-side"><view class="district-chip" wx:if="{{item.district}}">{{item.district}}</view><view class="card-arrow">›</view></view></view><view class="list-end">共 {{visibleItems.length}} 篇{{mode === 'policy' ? '政策资料' : '对口资料'}}</view></view>
  <view class="status" wx:else><text>暂无{{mode === 'policy' ? '政策资料' : '对口资料'}}</text></view>
</view>
