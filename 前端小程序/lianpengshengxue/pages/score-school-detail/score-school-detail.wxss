.reaction-header { display:flex; align-items:baseline; justify-content:space-between; gap:16rpx; margin-bottom:24rpx; }.reaction-title { color:#222; font-size:30rpx; font-weight:600; }.reaction-hint { color:#999; font-size:22rpx; }
.reaction-list { display:flex; justify-content:space-between; }.reaction-list.disabled { opacity:.6; pointer-events:none; }.reaction-item { width:116rpx; padding:12rpx 2rpx 10rpx; display:flex; flex-direction:column; align-items:center; border:2rpx solid transparent; border-radius:14rpx; box-sizing:border-box; }.reaction-item.selected { border-color:#64a8cd; background:#f1f9fd; }
