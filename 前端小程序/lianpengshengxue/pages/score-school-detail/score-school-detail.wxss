.qr-popup { position:fixed; left:50%; top:50%; width:620rpx; padding:35rpx; transform:translate(-50%,-50%); box-sizing:border-box; background:#fff; border-radius:20rpx; z-index:201; }.qr-img { display:block; width:100%; }.qr-close { top:-22rpx; right:-22rpx; width:52rpx; height:52rpx; font-size:42rpx; }
.reaction-card { margin:20rpx 0; padding:26rpx 20rpx 24rpx; background:#fff; border-radius:16rpx; box-shadow:0 4rpx 18rpx rgba(35,35,45,.06); }
