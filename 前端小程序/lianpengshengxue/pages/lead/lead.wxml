<view class="page">
  <!-- 顶部横幅图 -->
  <view class="banner-wrap">
    <image wx:if="{{bannerUrl}}" class="banner" src="{{bannerUrl}}" mode="widthFix"></image>
    <view class="back-btn" style="top:{{statusBarHeight + 8}}px;" bindtap="onBack">
      <view class="back-arrow"></view>
    </view>
  </view>

  <!-- 白色表单卡片 -->
  <view class="form-card">
    <view class="form-row">
      <text class="form-label">家长姓名</text>
      <input class="form-input" placeholder="请输入家长姓名" data-key="parentName" bindinput="onInput" value="{{parentName}}" />
    </view>
    <view class="form-sep"></view>

    <view class="form-row">
      <text class="form-label">孩子年级</text>
      <input class="form-input" placeholder="如：初三" data-key="childGrade" bindinput="onInput" value="{{childGrade}}" />
    </view>
    <view class="form-sep"></view>

    <view class="form-row">
      <text class="form-label">目标院校</text>
      <input class="form-input" placeholder="如：上海平和；若没有可填写暂无" data-key="targetSchool" bindinput="onInput" value="{{targetSchool}}" />
    </view>
    <view class="form-sep"></view>

    <view class="form-row">
      <text class="form-label">联系电话</text>
      <input class="form-input" placeholder="请输入手机号" type="number" data-key="parentPhone" bindinput="onInput" value="{{parentPhone}}" />
    </view>

    <!-- 疑问区 -->
    <view class="concern-section">
      <text class="form-label">您的疑问</text>
      <textarea class="concern-area" placeholder="输入您的问题，老师会尽快给您回电" placeholder-class="concern-placeholder" data-key="concern" bindinput="onInput" value="{{concern}}" maxlength="500" />
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="onSubmit">提交咨询</button>
  </view>
</view>

<phone-auth-modal required="{{phoneAuthRequired}}" />

