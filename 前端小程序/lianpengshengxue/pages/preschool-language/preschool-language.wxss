page { background:#f4f7f9; color:#263942; }
.page { min-height:100vh; }
.hero { padding:34rpx 28rpx 38rpx; color:#fff; background:linear-gradient(145deg,#397fa8 0%,#64a8cd 58%,#91c9e3 100%); border-radius:0 0 28rpx 28rpx; box-shadow:0 9rpx 24rpx rgba(45,105,137,.16); }
.hero-eyebrow { display:block; color:rgba(255,255,255,.7); font-size:17rpx; letter-spacing:3rpx; }
.hero-title { display:block; margin-top:10rpx; font-size:39rpx; line-height:54rpx; font-weight:800; }
.hero-sub { display:block; margin-top:13rpx; color:rgba(255,255,255,.88); font-size:23rpx; line-height:36rpx; }
.hero-tags { display:flex; margin-top:20rpx; }
.hero-tags text { margin-right:12rpx; padding:6rpx 20rpx; background:rgba(255,255,255,.18); border:1rpx solid rgba(255,255,255,.4); border-radius:24rpx; font-size:20rpx; }
.intro-card,.section-block,.guide-card { margin:22rpx 20rpx 0; padding:24rpx 22rpx; background:#fff; border:1rpx solid #e1e9ed; border-radius:20rpx; box-shadow:0 6rpx 20rpx rgba(44,80,98,.07); }
.section-title { display:flex; align-items:center; }
.section-title view { width:7rpx; height:32rpx; margin-right:11rpx; background:#64a8cd; border-radius:4rpx; }
.section-title text { font-size:30rpx; font-weight:700; }
.intro-copy,.section-note { display:block; margin-top:17rpx; color:#718188; font-size:23rpx; line-height:38rpx; }
.stage-list { display:flex; margin-top:20rpx; }
.stage-card { min-width:0; flex:1; padding:17rpx 12rpx; background:linear-gradient(155deg,#f8fcfe,#edf7fb); border:1rpx solid #dcecf3; border-radius:15rpx; }
.stage-card + .stage-card { margin-left:10rpx; }
.stage-head { display:flex; align-items:center; justify-content:space-between; }
.stage-head text:first-child { color:#31576a; font-size:26rpx; font-weight:700; }
.stage-head text:last-child { color:#8fa4ae; font-size:17rpx; }
.stage-goal { display:block; margin-top:8rpx; color:#4d92bb; font-size:20rpx; font-weight:600; }
.stage-desc { display:block; margin-top:9rpx; color:#74858d; font-size:18rpx; line-height:29rpx; }
.stage-tags { margin-top:9rpx; }
.stage-tags text { display:block; margin-top:5rpx; padding:4rpx; color:#5687a0; background:#fff; border-radius:8rpx; font-size:16rpx; text-align:center; }
.resources-block { padding-bottom:4rpx; }
.resource-card { margin:20rpx -2rpx 24rpx; padding:20rpx; border:1rpx solid #dcebf2; border-radius:17rpx; }
.resource-heading { display:flex; align-items:flex-end; justify-content:space-between; }
.resource-heading > view text:first-child { display:block; color:#8eb2c4; font-size:15rpx; letter-spacing:2rpx; }
.resource-heading > view text:last-child { display:block; margin-top:3rpx; font-size:28rpx; font-weight:700; }
.resource-index { color:#d8edf5; font-size:38rpx; font-weight:800; }
.resource-images { display:flex; height:238rpx; margin-top:16rpx; overflow:hidden; border-radius:13rpx; }
.resource-images image { width:100%; height:100%; }
.resource-images-2 image { width:50%; }
.resource-images-2 image + image { margin-left:6rpx; }
.resource-desc { display:block; margin-top:15rpx; color:#718188; font-size:22rpx; line-height:35rpx; }
.resource-points { display:flex; flex-wrap:wrap; margin-top:12rpx; }
.resource-points text { margin:0 8rpx 6rpx 0; padding:5rpx 11rpx; color:#5687a0; background:#edf6fa; border-radius:10rpx; font-size:18rpx; }
.guide-card { color:#fff; background:linear-gradient(135deg,#397fa8,#64a8cd 62%,#91c9e3); }
.guide-title { display:block; font-size:30rpx; font-weight:700; }
.guide-copy { display:block; margin-top:10rpx; color:rgba(255,255,255,.86); font-size:22rpx; line-height:35rpx; }
.guide-button { height:66rpx; display:flex; align-items:center; justify-content:center; margin-top:20rpx; color:#397fa8; background:#fff; border-radius:34rpx; font-size:25rpx; font-weight:700; }
.bottom-space { height:150rpx; }
.bottom-bar { position:fixed; left:0; right:0; bottom:0; z-index:100; display:flex; align-items:center; padding:16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); background:rgba(255,255,255,.97); border-top:1rpx solid #dce7ec; box-shadow:0 -5rpx 18rpx rgba(44,80,98,.07); }
.bottom-bar > view:first-child { min-width:0; flex:1; }
.bottom-bar > view:first-child text:first-child { display:block; font-size:23rpx; font-weight:700; }
.bottom-bar > view:first-child text:last-child { display:block; margin-top:3rpx; color:#8a989f; font-size:18rpx; }
.bottom-button { flex-shrink:0; margin-left:16rpx; padding:18rpx 25rpx; color:#fff; background:linear-gradient(135deg,#4d92bb,#64a8cd); border-radius:34rpx; font-size:24rpx; font-weight:700; }
