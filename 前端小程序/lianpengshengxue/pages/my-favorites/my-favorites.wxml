<view class="favorites-page">
  <view class="favorites-overview" wx:if="{{!loading && favorites.length}}">
    <view>
      <text class="overview-title">我的学校收藏</text>
      <text class="overview-tip">集中查看关注的学校，方便后续对比</text>
    </view>
    <view class="overview-count"><text class="overview-number">{{favorites.length}}</text><text>所</text></view>
  </view>

  <view class="favorite-card" wx:for="{{favorites}}" wx:key="favoriteKey"
    data-id="{{item.schoolId}}" data-source="{{item.schoolSource}}" bindtap="onTapSchool">
    <view class="card-accent"></view>
    <view class="school-logo-wrap">
      <image wx:if="{{item.displayLogo}}" class="school-logo" src="{{item.displayLogo}}" mode="aspectFit"></image>
      <text wx:else class="school-logo-fallback">{{item.schoolName ? item.schoolName[0] : '校'}}</text>
    </view>
    <view class="favorite-info">
      <text class="school-name">{{item.schoolName}}</text>
      <view class="school-tags">
        <text class="school-tag district-tag">{{item.district || '区域待定'}}</text>
        <text class="school-tag curriculum-tag">{{item.curriculum || '课程待定'}}</text>
      </view>
      <text class="school-grade">{{item.grades || '学段待确认'}}</text>
    </view>
    <view class="favorite-action">
      <view class="favorite-star">★</view>
      <text class="favorite-label">已收藏</text>
    </view>
    <text class="card-arrow">›</text>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-ring"></view>
    <text>正在加载收藏学校...</text>
  </view>

  <view class="empty-state" wx:if="{{!loading && favorites.length===0}}">
    <view class="empty-star">☆</view>
    <text class="empty-title">暂无收藏学校</text>
    <text class="empty-tip">在学校详情页点击收藏后，可在这里查看</text>
  </view>
</view>

<phone-auth-modal required="{{phoneAuthRequired}}" />

