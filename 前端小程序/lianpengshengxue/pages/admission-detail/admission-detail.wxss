page{background:#eef6fb;color:#171717}
.page{min-height:100vh;background:linear-gradient(180deg,#dff1f8 0,#edf8fc 420rpx,#f5f6f8 1000rpx)}

/* 顶部学校与招生进度 */
.hero{position:relative;padding:0 30rpx 24rpx;overflow:hidden;background:linear-gradient(145deg,#d4ebf6 0%,#eaf7fc 52%,#d8edf7 100%)}
.hero-glow{position:absolute;border-radius:50%;pointer-events:none}.hero-glow-left{width:420rpx;height:250rpx;left:-180rpx;top:-100rpx;background:radial-gradient(circle,rgba(77,146,187,.24),rgba(77,146,187,0) 70%)}.hero-glow-right{width:380rpx;height:280rpx;right:-170rpx;bottom:-80rpx;background:radial-gradient(circle,rgba(145,201,227,.38),rgba(145,201,227,0) 72%)}
.custom-nav{position:relative;z-index:3;width:100%}.custom-back{position:absolute;left:0;display:flex;align-items:center;justify-content:center;background:rgba(145,201,227,.42);border-radius:50%;box-shadow:0 4rpx 14rpx rgba(77,146,187,.08)}.custom-back-arrow{margin-top:-5rpx;color:#17252c;font-size:58rpx;line-height:1;font-weight:300}
.hero-row{position:relative;z-index:1;display:flex;align-items:center;margin-top:12rpx}
.hero-logo,.hero-logo-placeholder{width:132rpx;height:132rpx;flex-shrink:0;border-radius:12rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(77,146,187,.12)}
.hero-logo-placeholder{display:flex;align-items:center;justify-content:center;color:#4d92bb;font-size:48rpx;font-weight:700}
.hero-info{min-width:0;flex:1;margin-left:26rpx}.hero-name{display:block;color:#111;font-size:35rpx;line-height:48rpx;font-weight:700}.hero-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:13rpx}.hero-tag{padding:6rpx 13rpx;color:#3f83aa;background:rgba(255,255,255,.72);border:1rpx solid rgba(77,146,187,.32);border-radius:5rpx;font-size:22rpx;line-height:28rpx}.hero-tag-primary{color:#fff;border-color:transparent;background:linear-gradient(135deg,#4d92bb,#64a8cd)}
.progress-section{position:relative;z-index:1;margin-top:30rpx}.progress-heading{margin-bottom:13rpx}.progress-title-dot{width:16rpx;height:16rpx;margin-right:14rpx;flex-shrink:0;border-radius:50%;background:#64a8cd}.progress-content{color:#27333a}.progress-content .content-paragraph{margin-bottom:5rpx;font-size:27rpx;line-height:43rpx}

/* 锚点导航 */
.anchor-nav{position:relative;z-index:2;width:100%;height:86rpx;margin-top:12rpx;white-space:nowrap;background:transparent}
.anchor-nav-inner{height:86rpx;display:inline-flex;align-items:center;padding:0;box-sizing:border-box}
.anchor-item{height:58rpx;display:flex;align-items:center;padding:0 23rpx;margin-right:13rpx;color:#34383c;background:rgba(255,255,255,.92);border:1rpx solid rgba(100,168,205,.12);border-radius:18rpx;font-size:25rpx;box-sizing:border-box}.anchor-item.active{color:#fff;border-color:transparent;background:linear-gradient(135deg,#4d92bb,#64a8cd);box-shadow:0 6rpx 14rpx rgba(77,146,187,.22)}

/* 内容卡片 */
.content-list{padding:20rpx 16rpx 0}.info-card{position:relative;margin-bottom:20rpx;padding:34rpx 30rpx 38rpx;overflow:hidden;background:#fff;border:1rpx solid rgba(100,168,205,.08);border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(54,91,110,.055);box-sizing:border-box}.fold-corner{position:absolute;top:0;right:0;width:46rpx;height:46rpx;background:linear-gradient(225deg,#edf8fc 0 49%,#fff 51%);border-radius:0 27rpx 0 0}.graduation-card{background:linear-gradient(180deg,#fff,#fbfdfe)}
.section-heading{display:flex;align-items:center;color:#111;font-size:32rpx;line-height:44rpx;font-weight:700}.heading-icon{width:34rpx;height:34rpx;margin-right:10rpx;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,#4d92bb,#64a8cd);border-radius:9rpx;font-size:20rpx;line-height:1}.heading-icon.custom{width:44rpx;height:44rpx;background:transparent;border-radius:0}.heading-icon-image{width:44rpx;height:44rpx;display:block}.heading-icon.exam{border-radius:50%}
.detail-badge{display:inline-flex;margin:28rpx 0 20rpx;padding:7rpx 13rpx;color:#4d92bb;background:#eef8fc;border-radius:8rpx;font-size:26rpx;line-height:32rpx}.detail-rows{padding:0 10rpx}.detail-row{display:flex;align-items:flex-start;margin-bottom:17rpx;font-size:27rpx;line-height:43rpx}.detail-row:last-child{margin-bottom:0}.detail-label{flex-shrink:0;color:#111;font-weight:600}.detail-value{min-width:0;color:#222;word-break:break-all}.detail-value.highlight{color:#ff4b42}
.rich-content{margin-top:24rpx}.content-paragraph{display:block;margin-bottom:16rpx;color:#1c2226;font-size:27rpx;line-height:48rpx;word-break:break-all;white-space:pre-wrap}.content-paragraph:last-child{margin-bottom:0}

/* 入学测试咨询条 */
.consult-strip{height:66rpx;margin-top:24rpx;padding:0 10rpx 0 16rpx;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(90deg,#f2f9fc,#edf7fb);border-radius:34rpx;box-sizing:border-box}.consult-left{min-width:0;display:flex;align-items:center;color:#52616a;font-size:22rpx;white-space:nowrap}.consult-fire{margin-right:10rpx;color:#ff5448;font-size:28rpx}.consult-action{flex-shrink:0;margin-left:10rpx;padding:8rpx 15rpx;color:#fff;background:linear-gradient(135deg,#64a8cd,#4d92bb);border-radius:26rpx;font-size:21rpx}

/* 报名流程 */
.timeline-content{margin-top:27rpx}.timeline-row{display:flex;align-items:stretch;min-height:84rpx}.timeline-axis{position:relative;width:36rpx;flex-shrink:0}.timeline-dot{position:absolute;top:13rpx;left:3rpx;width:17rpx;height:17rpx;border:5rpx solid #d9edf6;background:#64a8cd;border-radius:50%;box-sizing:border-box;z-index:1}.timeline-line{position:absolute;top:29rpx;bottom:-13rpx;left:11rpx;border-left:2rpx dotted #91c9e3}.timeline-row:last-child .timeline-line{display:none}.timeline-text{flex:1;padding:0 0 24rpx 4rpx;color:#30434d;font-size:26rpx;line-height:43rpx;word-break:break-all}

/* 空态、结束语和返回顶部 */
.empty-state{margin:26rpx 20rpx;padding:110rpx 30rpx;display:flex;flex-direction:column;align-items:center;background:#fff;border-radius:28rpx}.empty-icon{width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(135deg,#4d92bb,#91c9e3);border-radius:50%;font-size:34rpx}.empty-title{margin-top:24rpx;color:#333;font-size:30rpx;font-weight:600}.empty-desc{margin-top:12rpx;color:#999;font-size:24rpx}.retry-btn{margin-top:30rpx;padding:0 38rpx;color:#fff;background:#64a8cd;border:0;border-radius:34rpx;font-size:25rpx}.retry-btn::after{border:0}
.end-note{padding:88rpx 30rpx 112rpx;display:flex;flex-direction:column;align-items:center;color:#66757e;font-size:24rpx;line-height:38rpx}.end-line{width:70rpx;height:5rpx;margin-bottom:28rpx;background:linear-gradient(90deg,#91c9e3,#64a8cd);border-radius:3rpx}.end-sub{margin-top:16rpx;color:#9aa8af;font-size:21rpx;line-height:34rpx}.back-top{position:fixed;right:24rpx;bottom:calc(158rpx + env(safe-area-inset-bottom));z-index:110;width:84rpx;height:84rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#4d92bb;background:rgba(255,255,255,.96);border:1rpx solid #d9edf6;border-radius:50%;box-shadow:0 5rpx 18rpx rgba(51,91,112,.12);font-size:19rpx}.back-arrow{font-size:34rpx;line-height:30rpx}.bottom-space{height:158rpx}

/* 加载骨架 */
.loading-page{padding:32rpx 26rpx}.skeleton{position:relative;overflow:hidden;background:#dcecf3;border-radius:12rpx}.skeleton::after{content:"";position:absolute;inset:0;transform:translateX(-100%);background:linear-gradient(90deg,transparent,rgba(255,255,255,.58),transparent);animation:shimmer 1.35s infinite}.skeleton-head{height:150rpx}.skeleton-line{height:32rpx;margin-top:24rpx}.skeleton-line.short{width:62%}.skeleton-card{height:390rpx;margin-top:34rpx;border-radius:28rpx}@keyframes shimmer{100%{transform:translateX(100%)}}

/* 底部操作栏 */
.bottom-bar{position:fixed;left:0;right:0;bottom:0;z-index:100;height:96rpx;padding:6rpx 14rpx calc(6rpx + env(safe-area-inset-bottom));display:flex;align-items:center;background:#fff;border-top:1rpx solid #d9d9d9;box-sizing:content-box}.bar-icons{display:flex;flex-shrink:0;gap:6rpx}.bar-icon-item{position:relative;width:82rpx;height:86rpx;padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#111;background:transparent;border:0;box-sizing:border-box}.share-hit-button{position:absolute;left:0;top:0;width:82rpx;height:86rpx;min-width:0;margin:0;padding:0;opacity:0;background:transparent;border:0;box-sizing:border-box}.share-hit-button::after{border:0}.bar-icon-image{width:42rpx;height:42rpx;display:block}.share-icon-image{width:28rpx;height:34rpx}.bar-label{margin-top:4rpx;font-size:20rpx;line-height:23rpx;white-space:nowrap}.material-icon-wrap{position:relative}.material-dot{position:absolute;top:-5rpx;right:-7rpx;width:12rpx;height:12rpx;background:#ff5448;border:3rpx solid #fff;border-radius:50%}.bar-actions{position:relative;z-index:2;min-width:0;flex:1;display:flex;gap:10rpx;margin-left:8rpx}.bar-action{height:76rpx;flex:1;display:flex;align-items:center;justify-content:center;border-radius:9rpx;font-size:27rpx;font-weight:600;white-space:nowrap}.bar-action.visit{color:#fff;background:#7857e8}.bar-action.consult{color:#111;background:#ffe532}

@media(max-width:340px){.hero-name{font-size:31rpx}.bar-icon-item,.share-hit-button{width:78rpx}.bar-label{font-size:18rpx}.bar-action{font-size:24rpx}.consult-left{font-size:20rpx}.consult-action{font-size:19rpx}}
