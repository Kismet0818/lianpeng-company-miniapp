page { background:#f4f7f9; color:#263942; }
.page { position:relative; top:-48rpx; min-height:calc(100vh + 48rpx); overflow-x:hidden; }
.hero-image { width:100%; height:auto; display:block; }
.preview-section { overflow:hidden; margin:22rpx 20rpx 0; background:#f4f7f9; border-radius:20rpx; }
.main-head { height:76rpx; display:flex; align-items:center; justify-content:space-between; padding:0 22rpx; color:#fff; background:linear-gradient(100deg,#4d92bb,#64a8cd); font-size:25rpx; font-weight:700; }
.main-head text:last-child { font-weight:500; }
.head-dot { margin-right:4rpx; font-size:17rpx; }
.main-body { display:flex; min-height:235rpx; margin-top:18rpx; padding:24rpx 22rpx; box-sizing:border-box; background:#fff; border-radius:20rpx; box-shadow:0 6rpx 20rpx rgba(44,80,98,.07); }
.main-head + .main-body { margin-top:0; border-radius:0 0 20rpx 20rpx; }
.main-cover { width:168rpx; flex-shrink:0; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#31576a; background:linear-gradient(145deg,#f1effd,#d6f5f6); border-radius:17rpx; }
.main-cover image { width:100%; height:100%; border-radius:17rpx; }
.main-cover text:first-child { padding:5rpx 14rpx; color:#4d92bb; background:#fff; border-radius:20rpx; font-size:19rpx; }
.main-cover text:last-child { margin-top:15rpx; font-size:27rpx; line-height:38rpx; font-weight:800; }
.main-copy { min-width:0; flex:1; margin-left:22rpx; position:relative; padding-bottom:48rpx; }
.main-title { display:block; font-size:29rpx; line-height:41rpx; font-weight:700; }
.main-sub { display:-webkit-box; margin-top:8rpx; overflow:hidden; color:#849198; font-size:20rpx; line-height:31rpx; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.channel-line { display:flex; align-items:center; min-width:0; }
.channel-line image { width:30rpx; height:30rpx; margin-right:8rpx; border-radius:50%; }
.main-time { position:absolute; left:0; bottom:5rpx; color:#ff554b; font-size:21rpx; }
.reserve-small { position:absolute; right:0; bottom:0; padding:10rpx 18rpx; color:#ff554b; background:#fff0ee; border-radius:25rpx; font-size:20rpx; }
.schedule-section { overflow:hidden; margin:22rpx 20rpx 0; border-radius:20rpx; }
.list-title { height:76rpx; display:flex; align-items:center; padding:0 22rpx; color:#fff; background:linear-gradient(100deg,#4d92bb,#64a8cd); font-size:25rpx; font-weight:700; }
.list-title text:first-child { margin-right:9rpx; font-size:17rpx; }
.live-card { display:flex; min-height:220rpx; margin:18rpx 0 0; padding:22rpx; background:#fff; border:1rpx solid #e4eaed; border-radius:19rpx; box-shadow:0 5rpx 17rpx rgba(44,80,98,.06); box-sizing:border-box; }
.list-title + .live-card { margin-top:0; border-radius:0 0 19rpx 19rpx; }
.section-status { padding:55rpx 20rpx; color:#9aa6ac; background:#fff; text-align:center; font-size:22rpx; }
.loading-state { margin:24rpx 20rpx 0; padding:90rpx 20rpx; color:#8c9aa1; background:#fff; border-radius:20rpx; text-align:center; font-size:24rpx; }
.retry-status { color:#4d92bb; }
.date-box { width:150rpx; flex-shrink:0; display:flex; flex-direction:column; align-items:center; justify-content:center; background:linear-gradient(145deg,#fff9d9,#ffe7df); border-radius:16rpx; }
.cover-box { overflow:hidden; background:#eef3f5; }
.cover-box image { width:100%; height:100%; display:block; border-radius:16rpx; }
.date-box text:first-child { color:#8b7133; font-size:23rpx; font-weight:700; }
.date-box text:nth-child(2) { margin-top:7rpx; color:#445862; font-size:28rpx; font-weight:800; }
.date-box text:last-child { margin-top:10rpx; padding:4rpx 14rpx; color:#ff554b; background:#fff; border-radius:18rpx; font-size:18rpx; }
.live-copy { min-width:0; flex:1; margin-left:20rpx; }
.speaker { display:block; color:#77868d; font-size:19rpx; }
.live-title { display:block; margin-top:7rpx; font-size:27rpx; line-height:39rpx; font-weight:700; }
.live-tags { display:flex; flex-wrap:wrap; margin-top:10rpx; }
.live-tags text { margin:0 7rpx 5rpx 0; padding:4rpx 9rpx; color:#5687a0; background:#edf6fa; border-radius:9rpx; font-size:17rpx; }
.live-meta { display:flex; align-items:center; justify-content:space-between; margin-top:12rpx; color:#9aa6ac; font-size:18rpx; }
.live-meta view { padding:9rpx 16rpx; color:#ff554b; background:#fff0ee; border-radius:24rpx; }
.reserve-small.disabled, .live-meta view.disabled { color:#9aa6ac; background:#eef1f2; }
.bottom-space { height:35rpx; }
