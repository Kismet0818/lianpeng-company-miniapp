page { background:#fafafa; color:#27262a; }
.page { min-height:100vh; background:#fafafa; padding-bottom:40rpx; }
.top-space { background:#fff; }
.nav-bar { height:92rpx; display:flex; align-items:center; justify-content:space-between; padding:0 42rpx; background:#fff; box-sizing:border-box; }
.nav-back,.nav-share { width:62rpx; height:62rpx; display:flex; align-items:center; justify-content:center; color:#242326; font-size:56rpx; font-weight:300; }
.nav-share { font-size:42rpx; }
.nav-title { font-size:32rpx; font-weight:600; }
.hero { padding:54rpx 50rpx 58rpx; background:#fff; border-bottom:1rpx solid #f3f3f3; }
.eyebrow { display:inline-flex; padding:6rpx 20rpx; border:3rpx solid #ed3154; border-radius:18rpx; color:#e92f52; font-size:24rpx; line-height:34rpx; }
.hero-title { display:block; margin-top:30rpx; font-size:62rpx; line-height:82rpx; font-weight:700; letter-spacing:1rpx; }
.hero-subtitle { display:block; margin-top:22rpx; color:#9c9b9d; font-size:27rpx; line-height:42rpx; }
.district-scroll { background:#fff; padding:34rpx 0 30rpx; box-sizing:border-box; }
.districts { display:flex; padding:0 50rpx; gap:22rpx; white-space:nowrap; }
.district-pill { min-width:142rpx; height:64rpx; display:inline-flex; align-items:center; justify-content:center; padding:0 24rpx; box-sizing:border-box; border-radius:34rpx; background:#f4f4f5; color:#555; font-size:27rpx; }
.district-pill.active { color:#fff; background:#ff2448; box-shadow:0 8rpx 16rpx rgba(255,36,72,.16); }
.list { padding:18rpx 28rpx 0; }
.school-card { display:flex; align-items:flex-start; min-height:230rpx; margin-bottom:24rpx; padding:24rpx; box-sizing:border-box; background:#fff; border:1rpx solid #f0f0f0; border-radius:18rpx; box-shadow:0 6rpx 24rpx rgba(27,24,30,.06); }
.school-image { width:222rpx; height:222rpx; flex:none; border-radius:16rpx; background:#edf1f3; }
.image-fallback { display:flex; align-items:center; justify-content:center; color:#86a3b2; font-size:60rpx; }
.school-copy { min-width:0; flex:1; display:flex; flex-direction:column; align-items:flex-start; padding:8rpx 0 0 28rpx; }
.school-name { display:-webkit-box; width:100%; color:#222124; font-size:30rpx; line-height:42rpx; font-weight:700; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.school-badge { margin-top:18rpx; padding:6rpx 16rpx; color:#5b83a0; background:#edf6fc; font-size:22rpx; line-height:30rpx; }
.school-address { margin-top:auto; width:100%; color:#aaa9ac; font-size:24rpx; line-height:36rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.state { padding:120rpx 0; color:#aaa; text-align:center; font-size:26rpx; }
