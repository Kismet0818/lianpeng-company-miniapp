page{background:#fff;color:#303236}.page{min-height:100vh;background:#fff}.custom-nav{position:relative;z-index:20;width:100%;background:#fff;box-sizing:border-box}.nav-back{position:absolute;left:20rpx;width:72rpx;display:flex;align-items:center;justify-content:center}.back-arrow{width:18rpx;height:18rpx;border-left:4rpx solid #222;border-bottom:4rpx solid #222;transform:rotate(45deg)}.nav-back:active{opacity:.55}.nav-title{position:absolute;left:120rpx;right:120rpx;overflow:hidden;color:#222;font-size:32rpx;font-weight:700;text-align:center;text-overflow:ellipsis;white-space:nowrap}.article{padding:16rpx 28rpx 100rpx;background:#fff}.title{display:block;color:#222;font-size:38rpx;line-height:54rpx;font-weight:700;letter-spacing:.2rpx}.author-row{display:flex;align-items:center;margin-top:24rpx}.author-avatar{display:block;width:62rpx;height:62rpx;border-radius:50%;background:#f1f1f1;overflow:hidden}.author-info{display:flex;flex-direction:column;margin-left:16rpx}.author-name{color:#353638;font-size:25rpx;line-height:34rpx}.publish-time{margin-top:2rpx;color:#a4a7aa;font-size:22rpx;line-height:30rpx}.divider{height:1rpx;margin-top:24rpx;background:#ededed}.topic{display:flex;align-items:center;width:max-content;margin-top:26rpx;padding:8rpx 14rpx;color:#777;background:#f7f7f7;border-radius:22rpx;font-size:22rpx}.topic-mark{margin-right:5rpx;color:#ee3f4b;font-size:27rpx;font-weight:700}.content{display:block;max-width:100%;margin-top:20rpx;color:#444;font-size:30rpx;line-height:1.95;word-break:break-word}.content image{display:block;max-width:100%;height:auto;margin:28rpx auto}.content p{display:block;max-width:100%;margin:28rpx 0;line-height:1.95}.content h1,.content h2,.content h3,.content h4{display:block;max-width:100%;margin:38rpx 0 22rpx;color:#222;font-weight:700;line-height:1.5}.content h2{font-size:36rpx}.content h3{font-size:32rpx}.content strong{font-weight:700}.content ul,.content ol{display:block;max-width:100%;margin:22rpx 0;padding-left:40rpx}.content li{display:list-item;margin:12rpx 0;line-height:1.9}.content blockquote{display:block;max-width:100%;margin:28rpx 0;padding:22rpx 24rpx;color:#666;border-left:6rpx solid #ef4b51;background:#fff7f7}.content table{width:100%;max-width:100%;margin:26rpx 0;border-collapse:collapse;font-size:25rpx}.content td,.content th{padding:14rpx 10rpx;border:1rpx solid #e1e1e1}.image{display:block;width:100%;margin-top:26rpx}.image-fallback{margin-top:26rpx;padding:40rpx;text-align:center;color:#9aa5aa;background:#f5f5f5}.status{text-align:center;padding:160rpx 30rpx;color:#999}.error text{display:block;margin-top:20rpx;color:#4d92bb}
 .article { position:relative; overflow:hidden; }
 .watermark-layer { position:absolute; z-index:50; top:240rpx; right:0; bottom:0; left:0; display:flex; flex-wrap:wrap; align-content:space-around; justify-content:space-around; pointer-events:none; }
 .watermark-item { width:100%; margin:70rpx 0; color:rgba(77,146,187,.17); font-size:68rpx; line-height:1.2; font-weight:700; text-align:center; white-space:nowrap; transform:rotate(-30deg); }
 .title,.author-row,.divider,.topic,.content,.image,.image-fallback { position:relative; z-index:2; }
.nav-title { display:none; }
