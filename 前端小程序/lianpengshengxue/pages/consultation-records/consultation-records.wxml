<view class="records-page">
  <view class="records-overview" wx:if="{{!loading && records.length}}">
    <view>
      <text class="overview-title">咨询进度</text>
      <text class="overview-tip">老师会根据您的需求尽快联系</text>
    </view>
    <view class="overview-count"><text>{{records.length}}</text><text class="overview-unit">条</text></view>
  </view>

  <view class="record-card" wx:for="{{records}}" wx:key="id">
    <view class="record-accent"></view>
    <view class="record-main">
      <view class="record-school-row">
        <view class="record-index">{{index + 1}}</view>
        <text class="record-school">{{item.targetSchool || '待确认学校'}}</text>
      </view>
      <text class="record-grade">{{item.childGrade || '年级待确认'}}</text>
    </view>
    <view class="record-footer">
      <view class="record-meta">
        <text class="record-label">咨询状态</text>
        <text class="record-time" wx:if="{{item.displayTime}}">{{item.displayTime}} 提交</text>
      </view>
      <view class="record-status {{item.status===1?'done':'pending'}}">
        <view class="status-dot"></view>
        <text>{{item.status===1?'已沟通':'等待联系'}}</text>
      </view>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-ring"></view>
    <text>正在加载咨询记录...</text>
  </view>

  <view class="empty-state" wx:if="{{!loading && records.length===0}}">
    <view class="empty-icon">咨</view>
    <text class="empty-title">暂无咨询记录</text>
    <text class="empty-tip">提交学校咨询后，可在这里查看进度</text>
  </view>
</view>

<phone-auth-modal required="{{phoneAuthRequired}}" />

