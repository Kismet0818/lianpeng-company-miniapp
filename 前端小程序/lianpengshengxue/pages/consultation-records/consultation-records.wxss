.records-page { min-height:100vh; padding:24rpx; background:linear-gradient(180deg,#f2f8fb 0%,#f5f6f8 260rpx); box-sizing:border-box; }
.records-overview { min-height:132rpx; margin-bottom:22rpx; padding:26rpx 28rpx; display:flex; align-items:center; justify-content:space-between; box-sizing:border-box; color:#fff; background:linear-gradient(135deg,#4d92bb,#64a8cd 62%,#91c9e3); border-radius:22rpx; box-shadow:0 10rpx 24rpx rgba(77,146,187,.18); }
.overview-title { display:block; font-size:32rpx; line-height:44rpx; font-weight:600; }
.overview-tip { display:block; margin-top:5rpx; color:rgba(255,255,255,.82); font-size:22rpx; }
.overview-count { display:flex; align-items:baseline; padding-left:24rpx; }
.overview-count>text:first-child { font-size:54rpx; line-height:60rpx; font-weight:700; }
.overview-unit { margin-left:5rpx; font-size:22rpx; }
.record-card { position:relative; overflow:hidden; margin-bottom:20rpx; padding:28rpx 26rpx 24rpx; background:#fff; border:1rpx solid rgba(100,168,205,.1); border-radius:20rpx; box-shadow:0 7rpx 20rpx rgba(43,73,92,.06); }
.record-accent { position:absolute; top:0; left:0; right:0; height:5rpx; background:linear-gradient(90deg,#64a8cd,#91c9e3 62%,rgba(145,201,227,0)); }
.record-main { display:flex; align-items:center; justify-content:space-between; padding-bottom:24rpx; border-bottom:1rpx solid #edf0f2; }
.record-school-row { min-width:0; flex:1; display:flex; align-items:center; }
.record-index { width:42rpx; height:42rpx; margin-right:14rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:#fff; background:linear-gradient(135deg,#4d92bb,#64a8cd); border-radius:12rpx; font-size:22rpx; font-weight:600; }
.record-school { min-width:0; color:#171717; font-size:30rpx; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.record-grade { margin-left:18rpx; padding:7rpx 15rpx; flex-shrink:0; color:#4d92bb; background:#eef8fc; border-radius:22rpx; font-size:23rpx; }
.record-footer { display:flex; align-items:flex-end; justify-content:space-between; padding-top:22rpx; }
.record-meta { display:flex; flex-direction:column; }
.record-label { color:#8c9298; font-size:24rpx; }
.record-time { margin-top:7rpx; color:#b0b4b8; font-size:20rpx; }
.record-status { height:46rpx; padding:0 17rpx; display:flex; align-items:center; border-radius:24rpx; font-size:23rpx; }
.record-status.pending { color:#3f83aa; background:#edf7fc; }
.record-status.done { color:#2d9160; background:#edf9f3; }
.status-dot { width:12rpx; height:12rpx; margin-right:9rpx; border-radius:50%; background:currentColor; box-shadow:0 0 0 5rpx rgba(100,168,205,.12); }
.record-status.done .status-dot { box-shadow:0 0 0 5rpx rgba(45,145,96,.11); }
.loading-state,.empty-state { display:flex; flex-direction:column; align-items:center; padding-top:210rpx; color:#a2a7ac; font-size:24rpx; }
.loading-ring { width:42rpx; height:42rpx; margin-bottom:20rpx; border:5rpx solid #dceef6; border-top-color:#64a8cd; border-radius:50%; animation:spin .8s linear infinite; }
.empty-icon { width:94rpx; height:94rpx; margin-bottom:24rpx; display:flex; align-items:center; justify-content:center; color:#64a8cd; background:#eaf6fb; border-radius:50%; font-size:38rpx; font-weight:600; }
.empty-title { color:#62686e; font-size:30rpx; }
.empty-tip { margin-top:14rpx; color:#aeb3b7; font-size:24rpx; }
@keyframes spin { to { transform:rotate(360deg); } }
