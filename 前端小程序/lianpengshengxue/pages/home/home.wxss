/* 自定义导航栏下的状态栏区域与首页顶部横幅衔接，避免出现浅灰空白带 */
page { background: #4d92bb; }
.page { min-height: 100vh; color: #222; overflow-x: hidden; background:linear-gradient(#4d92bb 0 76px,#f5f6f8 76px 100%); }
.advisor-float { position:fixed; right:24rpx; bottom:calc(118rpx + env(safe-area-inset-bottom)); z-index:90; width:116rpx; height:116rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; border:1rpx solid rgba(255,255,255,.72); border-radius:50%; background:rgba(255,255,255,.48); box-shadow:0 10rpx 28rpx rgba(39,91,122,.24),inset 0 1rpx 0 rgba(255,255,255,.8); backdrop-filter:blur(18rpx); }.advisor-float image{width:58rpx;height:58rpx}.advisor-float text{margin-top:2rpx;color:#2e7198;font-size:17rpx;font-weight:600}
.hero { position: relative; width:100vw; padding: 0 28rpx 24rpx; background:linear-gradient(145deg,#4d92bb 0%,#64a8cd 48%,#91c9e3 100%); border-radius: 0 0 22rpx 22rpx; overflow: hidden; box-sizing:border-box; box-shadow:0 10rpx 28rpx rgba(15,52,96,.12); }
.hero-bg { position: absolute; inset: 0; opacity: .28; background-position: center; background-size: cover; pointer-events: none; }
.hero::after { content:""; position:absolute; width:460rpx; height:300rpx; right:-120rpx; bottom:-110rpx; border-radius:50%; background:radial-gradient(circle,rgba(109,184,230,.3) 0%,rgba(255,255,255,.1) 42%,rgba(255,255,255,0) 72%); filter:blur(12rpx); }
.brand-row,.tool-row { position: relative; z-index: 1; }
.hero-company-logo { position:absolute; z-index:1; top:12rpx; left:50%; display:block; width:330rpx; height:auto; transform:translateX(-50%) scaleY(1.18); transform-origin:center top; }
.brand-row { display:flex; align-items:center; color:#fff; min-height:72rpx; }
.brand-mark { width:54rpx; height:54rpx; display:flex; align-items:center; justify-content:center; border-radius:14rpx 14rpx 18rpx 18rpx; background:linear-gradient(#f7d85b,#bb2828); border:3rpx solid rgba(255,255,255,.75); font-size:24rpx; font-weight:700; box-shadow:0 4rpx 10rpx rgba(60,24,120,.25); }
.brand-name { margin-left:16rpx; font-size:34rpx; font-weight:600; letter-spacing:1rpx; }
.capsule { margin-left:auto; width:208rpx; height:64rpx; border-radius:36rpx; background:rgba(255,255,255,.72); color:#151326; display:flex; align-items:center; justify-content:space-around; }
.capsule-dot { font-size:28rpx; letter-spacing:3rpx; transform:translateY(-4rpx); }.capsule-line{height:36rpx;width:2rpx;background:rgba(36,29,72,.2)}.capsule-minus{font-weight:700;font-size:28rpx}.capsule-ring{width:28rpx;height:28rpx;border:4rpx solid #17152b;border-radius:50%;display:flex;align-items:center;justify-content:center}.capsule-ring-inner{width:8rpx;height:8rpx;background:#17152b;border-radius:50%}
.tool-row { display:flex; align-items:center; margin-top:0; }
.location { display:flex; align-items:center; gap:10rpx; color:#fff; font-size:29rpx; font-weight:500; white-space:nowrap; }
.location-icon-image{width:28rpx;height:32rpx;display:block;flex-shrink:0}
.content { padding-top:6rpx; padding-bottom:calc(108rpx + env(safe-area-inset-bottom)); }.tabs{width:100%;white-space:nowrap;height:84rpx}.tab{display:inline-flex;height:84rpx;align-items:center;justify-content:center;margin:0 24rpx;font-size:28rpx;color:#666;position:relative}.tab.active{color:#202020;font-weight:600}.tab.active::after{content:"";position:absolute;bottom:4rpx;left:50%;transform:translateX(-50%);width:38rpx;height:5rpx;background:#c8c1e9;border-radius:3rpx}
.school-list { white-space:nowrap; width:100%; padding:14rpx 0 20rpx 22rpx; box-sizing:border-box; }.school-card{display:inline-flex;vertical-align:top;white-space:normal;width:174rpx;height:242rpx;margin-right:14rpx;padding:16rpx 12rpx;box-sizing:border-box;background:#fff;border:1rpx solid #dddfe5;border-radius:10rpx;flex-direction:column;align-items:center}.logo-wrap{height:88rpx;width:112rpx;display:flex;align-items:center;justify-content:center}.school-logo{width:106rpx;height:82rpx}.logo-fallback{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border-radius:50%;background:#edf5ee;color:#5b8f63;font-size:22rpx}.school-name{display:-webkit-box;width:100%;height:64rpx;margin-top:8rpx;font-size:22rpx;line-height:32rpx;color:#5e6270;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;word-break:break-all}.school-badge{padding:3rpx 10rpx;margin-top:auto;color:#ff3429;background:#fff0e7;border-radius:6rpx;font-size:20rpx}.more-card{justify-content:center}.more-circle{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#eaf6fb;color:#64a8cd;font-size:50rpx}.more-text{font-size:22rpx;color:#888;margin-top:18rpx}

/* 学校卡片横向自动轮播 */
.school-swiper { width:100%; height:258rpx; }
.school-swiper .school-card { width:auto; margin-right:0; }
.school-empty { height:180rpx; display:flex; align-items:center; justify-content:center; color:#999; font-size:24rpx; }

/* 查看更多 */
.more-row { text-align:right; padding:0 28rpx 10rpx; font-size:24rpx; color:#4d92bb; }

/* 热门地区 */
.district-section { margin:20rpx 16rpx; padding:22rpx 20rpx 24rpx; background:#fff; border-radius:18rpx; box-shadow:0 4rpx 18rpx rgba(49,39,92,.05); }
.district-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:18rpx; }
.district-title-row { display:flex; align-items:center; gap:8rpx; }
.district-bar { width:8rpx; height:34rpx; background:linear-gradient(180deg,#91c9e3,#64a8cd); border-radius:2rpx; }
.district-title { font-size:32rpx; font-weight:700; color:#171717; }
.district-hot-icon { width:34rpx; height:34rpx; display:block; flex-shrink:0; }
.chat-tag { height:54rpx; padding:0 15rpx 0 8rpx; display:flex; align-items:center; box-sizing:border-box; background:linear-gradient(90deg,#f2fff8,#fff4fb); border-radius:30rpx; color:#7c2457; }
.chat-icon-image { width:42rpx; height:42rpx; margin-right:8rpx; display:block; flex-shrink:0; }
.chat-text { font-size:23rpx; white-space:nowrap; }
.chat-arrow { margin-left:4rpx; font-size:28rpx; line-height:1; }
.district-grid { display:flex; flex-wrap:wrap; gap:14rpx 18rpx; }
.district-card { position:relative; overflow:hidden; width:calc((100% - 54rpx) / 4); height:126rpx; padding:18rpx 14rpx 14rpx; box-sizing:border-box; display:flex; flex-direction:column; background:linear-gradient(155deg,#fff 0%,#f5fafc 58%,#eaf5fa 100%); border:1rpx solid rgba(100,168,205,.18); border-radius:14rpx; box-shadow:0 6rpx 16rpx rgba(53,118,153,.07),inset 0 1rpx 0 rgba(255,255,255,.9); }
.district-card::before { content:""; position:absolute; top:0; left:0; right:0; height:5rpx; background:linear-gradient(90deg,#64a8cd 0%,#91c9e3 58%,rgba(145,201,227,0) 100%); }
.district-card:active { transform:translateY(1rpx); opacity:.92; }
.district-name { position:relative; z-index:1; font-size:26rpx; line-height:36rpx; color:#27232e; white-space:nowrap; }
.district-number-row { position:relative; z-index:1; display:flex; align-items:baseline; margin-top:4rpx; }
.district-count { font-size:37rpx; line-height:44rpx; font-weight:700; color:#4d92bb; }
.district-unit { margin-left:4rpx; font-size:19rpx; color:#77727f; font-weight:400; }
.district-art-placeholder { position:absolute; right:-28rpx; bottom:-38rpx; width:92rpx; height:106rpx; border-radius:20rpx; background:linear-gradient(145deg,rgba(100,168,205,.13),rgba(145,201,227,.03)); transform:rotate(24deg); }

/* 二维码弹窗 */
.qr-mask { position:fixed; inset:0; background:rgba(0,0,0,.62); z-index:300; }
.qr-popup { position:fixed; top:50%; left:50%; width:540rpx; transform:translate(-50%,-50%); z-index:301; }
.qr-img { width:100%; display:block; border-radius:24rpx; }
.qr-close { position:absolute; top:-66rpx; right:-4rpx; z-index:1; width:54rpx; height:54rpx; display:flex; align-items:center; justify-content:center; color:#fff; background:rgba(30,30,30,.72); border:2rpx solid rgba(255,255,255,.7); border-radius:50%; font-size:45rpx; line-height:1; font-weight:200; }

/* 开屏广告：每个小程序会话仅展示一次 */
.startup-ad-mask { position:fixed; inset:0; z-index:10000; padding:calc(40rpx + env(safe-area-inset-top)) 48rpx calc(40rpx + env(safe-area-inset-bottom)); display:flex; align-items:center; justify-content:center; box-sizing:border-box; background:rgba(12,28,38,.68); }
.startup-ad-dialog { position:relative; width:100%; max-width:654rpx; }
.startup-ad-image { display:block; width:100%; height:auto; border-radius:24rpx; box-shadow:0 18rpx 50rpx rgba(10,35,50,.24); }
.startup-ad-close { position:absolute; top:-72rpx; right:0; width:56rpx; height:56rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; color:#fff; background:rgba(20,37,47,.78); border:2rpx solid rgba(255,255,255,.78); border-radius:50%; font-size:44rpx; line-height:1; font-weight:300; }
.startup-ad-close:active { opacity:.76; transform:scale(.96); }
.quick-section{margin:20rpx 16rpx;padding:22rpx 18rpx 26rpx;background:#fff;border-radius:18rpx;box-shadow:0 4rpx 18rpx rgba(49,39,92,.05)}
.home-shortcuts{display:flex;align-items:flex-start;margin:0 16rpx 16rpx;padding:18rpx 8rpx 16rpx;background:#fff;border-radius:18rpx;box-shadow:0 4rpx 18rpx rgba(49,39,92,.05)}
.home-shortcut{width:20%;display:flex;flex-direction:column;align-items:center;color:#27343b;font-size:22rpx;line-height:32rpx;white-space:nowrap}
.home-shortcut-icon{width:68rpx;height:68rpx;margin-bottom:8rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:#f2f8fb}
.home-shortcut-icon image{width:48rpx;height:48rpx;display:block;filter:brightness(0) saturate(100%) invert(28%) sepia(93%) saturate(2534%) hue-rotate(344deg) brightness(94%) contrast(90%)}
.home-shortcut:active{opacity:.72;transform:scale(.97)}
.home-topics{display:flex;margin:0 16rpx 18rpx;background:#fff;border-radius:14rpx;box-shadow:0 4rpx 18rpx rgba(49,39,92,.05);overflow:hidden}
.home-topic{position:relative;width:33.333%;min-height:112rpx;padding:16rpx 10rpx 12rpx 14rpx;box-sizing:border-box;border-right:1rpx solid #edf0f2}
.home-topic:last-child{border-right:0}
.home-topic-copy{display:flex;flex-direction:column;align-items:flex-start;position:relative;z-index:1}
.home-topic-title{color:#262d32;font-size:25rpx;line-height:36rpx;font-weight:600;white-space:nowrap}
.home-topic-count{margin-top:4rpx;color:#9aa2a8;font-size:20rpx;line-height:28rpx;white-space:nowrap}
.home-topic-icon{position:absolute;right:8rpx;bottom:8rpx;width:46rpx;height:46rpx;opacity:.9}
.home-topic:active{background:#f8fbfc}
.quick-title{margin:0 0 22rpx;font-size:32rpx;line-height:42rpx;font-weight:700;color:#242424}
.quick-grid{display:flex;align-items:flex-start}
.quick-item{width:25%;display:flex;flex-direction:column;align-items:center;color:#242424}
.quick-icon-circle{width:96rpx;height:96rpx;margin-bottom:12rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:50%;background:linear-gradient(145deg,#fafafd 0%,#f0f1f5 55%,#e4e6eb 100%);box-shadow:0 6rpx 14rpx rgba(80,86,100,.06)}
.quick-icon-image{width:52rpx;height:52rpx;display:block;flex-shrink:0}
.quick-label{font-size:25rpx;line-height:36rpx;white-space:nowrap;text-align:center}

/* 择校攻略 */
.strategy-section { margin:20rpx 16rpx; padding:22rpx 0 24rpx; overflow:hidden; background:#fff; border-radius:18rpx; box-shadow:0 4rpx 18rpx rgba(49,39,92,.05); }
.strategy-title-row { display:flex; align-items:center; gap:10rpx; padding:0 20rpx; }
.strategy-bar { width:8rpx; height:34rpx; flex-shrink:0; border-radius:3rpx; background:linear-gradient(180deg,#91c9e3,#64a8cd); }
.strategy-title { color:#171717; font-size:32rpx; line-height:42rpx; font-weight:700; }
.strategy-scroll { width:100%; height:286rpx; margin-top:20rpx; padding-left:20rpx; box-sizing:border-box; white-space:nowrap; }
.strategy-card { position:relative; overflow:hidden; display:inline-block; width:198rpx; height:274rpx; margin-right:16rpx; vertical-align:top; background:linear-gradient(145deg,#eef8fc,#dceef6); border:1rpx solid rgba(100,168,205,.18); border-radius:15rpx; box-sizing:border-box; }
.strategy-image,.strategy-image-placeholder { position:absolute; inset:0; width:100%; height:100%; }
.strategy-image-placeholder { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12rpx; color:#8eb3c6; background:linear-gradient(145deg,#e9f6fb,#d7edf7); font-size:21rpx; }
.strategy-placeholder-icon { width:58rpx; height:58rpx; display:flex; align-items:center; justify-content:center; color:#fff; background:rgba(100,168,205,.72); border-radius:16rpx; font-size:24rpx; }
.strategy-video-mark { position:absolute; z-index:3; top:10rpx; left:10rpx; width:30rpx; height:30rpx; display:flex; align-items:center; justify-content:center; color:#fff; background:rgba(24,61,81,.58); border-radius:6rpx; font-size:14rpx; }
.strategy-card-shade { position:absolute; z-index:1; left:0; right:0; bottom:0; height:150rpx; background:linear-gradient(0deg,rgba(20,55,75,.72),rgba(20,55,75,0)); }
.strategy-card-title { position:absolute; z-index:2; left:14rpx; right:14rpx; bottom:16rpx; max-height:96rpx; overflow:hidden; color:#fff; font-size:25rpx; line-height:32rpx; font-weight:600; white-space:normal; text-shadow:0 2rpx 5rpx rgba(0,0,0,.2); }

/* 当前 Tab：蓝紫色短下划线 */
.tab.active{color:#202020;font-weight:700}
.tab.active::after{height:6rpx;background:linear-gradient(90deg,#4d92bb,#64a8cd);border-radius:4rpx}

/* 择校指南 */
.guide-section { margin:20rpx 16rpx 30rpx; padding:22rpx 18rpx 24rpx; background:#fff; border-radius:18rpx; box-shadow:0 4rpx 18rpx rgba(49,39,92,.05); }
.guide-title-row { display:flex; align-items:center; gap:10rpx; margin-bottom:22rpx; }
.guide-bar { width:8rpx; height:34rpx; background:linear-gradient(180deg,#91c9e3,#64a8cd); border-radius:2rpx; }
.guide-title { font-size:32rpx; font-weight:500; color:#171717; }
.guide-timeline { position:relative; padding-left:54rpx; }
.guide-timeline::before { content:""; position:absolute; left:21rpx; top:24rpx; bottom:24rpx; border-left:2rpx dashed #c9e2ee; }
.guide-step { position:relative; margin-bottom:24rpx; }
.guide-step:last-child { margin-bottom:0; }
.step-node-row { min-height:46rpx; display:flex; align-items:center; }
.step-dot { position:absolute; left:-54rpx; top:0; width:44rpx; height:44rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:linear-gradient(135deg,#4d92bb,#64a8cd); box-shadow:0 4rpx 10rpx rgba(77,146,187,.2); z-index:1; }
.step-icon-placeholder { width:24rpx; height:24rpx; border-radius:6rpx; background:rgba(255,255,255,.9); }
.step-icon-image { width:46rpx; height:46rpx; display:block; filter:brightness(0) invert(1); }
.step-header { flex:1; display:flex; align-items:baseline; gap:12rpx; min-width:0; }
.step-title { font-size:29rpx; line-height:42rpx; font-weight:500; color:#27252b; white-space:nowrap; }
.step-sub { font-size:21rpx; line-height:32rpx; color:#8f8b94; white-space:nowrap; }
.step-menu-card { display:flex; margin-top:14rpx; padding:24rpx 8rpx 22rpx; background:linear-gradient(145deg,#f5fbfe,#edf7fb); border-radius:20rpx; }
.step-menu-item { width:25%; display:flex; flex-direction:column; align-items:center; text-align:center; }
.menu-icon-placeholder { width:42rpx; height:42rpx; margin-bottom:12rpx; border-radius:10rpx; background:#91c9e3; }
.menu-icon-image { width:42rpx; height:42rpx; margin-bottom:12rpx; display:block; filter:hue-rotate(310deg) saturate(.72) brightness(1.08); }
.menu-icon-image.menu-icon-school { width:38rpx; height:38rpx; margin-top:2rpx; margin-bottom:14rpx; filter:saturate(.45) brightness(1.18); }
.menu-text { font-size:23rpx; line-height:34rpx; color:#17161a; white-space:nowrap; }

/* Banner 广告轮播 */
.banner-swiper { width:calc(100% - 48rpx); margin:20rpx 24rpx; height:180rpx; border-radius:12rpx; overflow:hidden; }
.banner-card { height:100%; overflow:hidden; background:#fff; }
.banner-image { width:100%; height:100%; display:block; }
.banner-left { margin-right:20rpx; }
.banner-thumb { width:80rpx; height:80rpx; background:rgba(255,255,255,.2); border-radius:12rpx; display:flex; align-items:center; justify-content:center; font-size:40rpx; }
.banner-mid { flex:1; min-width:0; }
.banner-main { font-size:28rpx; font-weight:700; color:#FFDD21; display:block; }
.banner-sub { font-size:24rpx; color:#fff; display:block; margin-top:4rpx; }
.banner-tag { display:inline-block; font-size:18rpx; background:#FFDD21; color:#333; padding:2rpx 10rpx; border-radius:6rpx; margin-top:6rpx; }
.banner-right { flex-shrink:0; }
.banner-btn { font-size:24rpx; color:#fff; padding:12rpx 20rpx; border:2rpx solid rgba(255,255,255,.5); border-radius:28rpx; white-space:nowrap; }

/* 招生动态 */
.notice-section { margin:0 24rpx 30rpx; }
.notice-title-row { display:flex; align-items:center; gap:8rpx; margin-bottom:12rpx; }
.notice-bar { width:6rpx; height:28rpx; background:linear-gradient(180deg,#91c9e3,#64a8cd); border-radius:4rpx; }
.notice-title { font-size:30rpx; font-weight:700; color:#333; }
.notice-list { background:#fff; border-radius:14rpx; padding:0 24rpx; }
.notice-item { display:block; font-size:28rpx; color:#555; line-height:80rpx; border-bottom:1rpx solid #F5F5F5; }
.notice-item:last-child { border-bottom:none; }

/* 品牌页脚 */
.footer-brand { position:relative; overflow:hidden; margin:10rpx 0 0; padding:38rpx 28rpx 50rpx; color:#123a66; background:transparent; text-align:center; }
.footer-website-section { margin:0 0 34rpx; }
.footer-website-action { min-height:128rpx; padding:26rpx 32rpx; display:flex; align-items:center; box-sizing:border-box; color:#fff; background:#174b83; border-radius:10rpx; text-align:left; transition:transform 180ms ease, background-color 180ms ease; }
.footer-website-action-active { background:#123f70; transform:scale(.985); }
.footer-website-copy { flex:1; min-width:0; }
.footer-website-title { display:block; font-size:31rpx; line-height:42rpx; font-weight:600; }
.footer-website-description { display:block; margin-top:5rpx; color:rgba(255,255,255,.72); font-size:23rpx; line-height:34rpx; }
.footer-website-arrow { width:18rpx; height:18rpx; margin:0 10rpx 0 28rpx; border-top:3rpx solid rgba(255,255,255,.9); border-right:3rpx solid rgba(255,255,255,.9); transform:rotate(45deg); }
.footer-website-url { display:block; margin-top:18rpx; color:#7d8792; font-size:22rpx; line-height:32rpx; text-align:center; letter-spacing:1rpx; }
.footer-brand::before { content:""; position:absolute; top:0; left:50%; width:88%; height:1rpx; background:linear-gradient(90deg,transparent,#d7e8f0 18%,#d7e8f0 82%,transparent); transform:translateX(-50%); }
.footer-company-logo { position:relative; z-index:2; display:block; width:330rpx; height:auto; margin:0 auto; }
.footer-book { position:relative; width:330rpx; height:30rpx; margin:-8rpx auto 0; }
.footer-book view { position:absolute; bottom:5rpx; width:146rpx; height:30rpx; border-bottom:3rpx solid #c6e0ec; }
.footer-book view:first-child { left:0; border-radius:0 0 100% 0; transform:skewY(8deg); }
.footer-book view:nth-child(2) { right:0; border-radius:0 0 0 100%; transform:skewY(-8deg); }
.footer-slogan-row { display:flex; align-items:center; justify-content:center; margin-top:-13rpx; }
.footer-slogan-row > text { color:#0f3460; background:linear-gradient(90deg,#0f3460 0%,#2c6292 50%,#0f3460 100%); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; font-family:Georgia,serif; font-size:27rpx; line-height:38rpx; font-style:italic; font-weight:600; letter-spacing:1rpx; }
.footer-tags { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; margin-top:8rpx; color:#8097a3; font-size:20rpx; letter-spacing:1rpx; }
.footer-tags i { margin:0 9rpx; color:#c99b36; font-style:normal; }
.beian-footer { display:flex; justify-content:center; align-items:center; flex-wrap:wrap; gap:10rpx 26rpx; margin-top:24rpx; padding:18rpx 16rpx calc(18rpx + env(safe-area-inset-bottom)); color:#666; font-size:20rpx; }
.beian-link { display:inline-flex; align-items:center; gap:7rpx; color:inherit; }
.beian-link image { width:36rpx; height:40rpx; object-fit:contain; }
.hot-articles-section{margin:24rpx 20rpx 0;padding:24rpx 22rpx;background:#fff;border-radius:20rpx;border:1rpx solid #e1eff7}.hot-articles-title-row{display:flex;align-items:center;margin-bottom:10rpx}.hot-articles-bar{width:7rpx;height:30rpx;margin-right:12rpx;background:#64a8cd;border-radius:6rpx}.hot-articles-title{font-size:30rpx;font-weight:700;color:#263f4e}.hot-articles-more{margin-left:auto;color:#77a5bb;font-size:21rpx}.hot-article-item{display:flex;align-items:center;min-height:116rpx;padding:14rpx 0;border-bottom:1rpx solid #edf4f7}.hot-article-item:last-child{border-bottom:0}.hot-article-cover{width:124rpx;height:84rpx;flex-shrink:0;border-radius:10rpx;background:#dff1fa}.hot-article-cover-fallback{display:flex;align-items:center;justify-content:center;color:#fff;background:#64a8cd;font-size:34rpx}.hot-article-copy{flex:1;min-width:0;margin-left:18rpx}.hot-article-name{display:block;color:#304b5b;font-size:26rpx;font-weight:600;line-height:1.45;white-space:normal}.hot-article-hint{display:block;margin-top:8rpx;color:#9ab1bd;font-size:21rpx}.hot-article-arrow{margin-left:12rpx;color:#64a8cd;font-size:42rpx;font-weight:300}
.school-district{display:block;width:100%;margin-top:2rpx;color:#9aa7ad;font-size:18rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
