page { min-height:100%; background:#f5f5f5; }
.container { position:relative; min-height:100vh; display:flex; flex-direction:column; background:#f5f5f5; box-sizing:border-box; }
.status-bar-fill { position:fixed; top:0; left:0; right:0; z-index:0; background:#f1eaff; pointer-events:none; }
.login-box,.profile-card { position:relative; z-index:1; }
/* 用户信息卡片 */
.profile-card { position:relative; display:flex; align-items:center; min-height:374rpx; padding-right:34rpx; padding-bottom:38rpx; padding-left:34rpx; background:linear-gradient(135deg,#f1eaff 0%,#edf4ff 52%,#effcf8 100%); box-sizing:border-box; }
.profile-card::after { content:""; position:absolute; left:0; right:0; bottom:0; height:78rpx; background:linear-gradient(0deg,rgba(255,255,255,.72),rgba(255,255,255,0)); pointer-events:none; }
.avatar-btn { position:relative; z-index:1; width:112rpx; min-width:112rpx; max-width:112rpx; height:112rpx; min-height:112rpx; max-height:112rpx; flex:0 0 112rpx; padding:0; margin:0; border:5rpx solid rgba(255,255,255,.9); border-radius:50%; overflow:hidden; background:#fff; line-height:1; box-sizing:border-box; box-shadow:0 4rpx 14rpx rgba(76,71,120,.10); }
.avatar-btn::after { border:none; }
.avatar { width:100%; height:100%; border-radius:50%; }
.avatar-placeholder { width:100%; height:100%; border-radius:50%; background:#e6eaf0; display:flex; align-items:center; justify-content:center; font-size:46rpx; }
.profile-info { position:relative; z-index:1; min-width:0; flex:1; margin-left:22rpx; }
.nickname-input { width:100%; height:52rpx; font-size:34rpx; font-weight:500; color:#172554; }
.profile-hint { display:block; margin-top:2rpx; font-size:22rpx; color:#8f96a0; }
.phone-row { margin-top:4rpx; }
.phone-btn { min-width:210rpx; height:44rpx; line-height:42rpx; font-size:22rpx; color:#ee941d; background:rgba(255,249,236,.9); border:1rpx solid #efb24f; border-radius:22rpx; padding:0 22rpx; display:inline-block; margin:0; }
.phone-btn::after { border:none; }
.phone-bound { font-size:23rpx; color:#7b8088; }
.logout-btn { position:relative; z-index:1; margin-left:18rpx; padding:8rpx 18rpx; border:1rpx solid rgba(130,130,140,.35); border-radius:24rpx; color:#858993; font-size:23rpx; white-space:nowrap; background:rgba(255,255,255,.45); }
/* 个人中心菜单 */
.user-menu { padding-left:34rpx; background:#fff; border-top:14rpx solid #f5f5f5; }
.menu-item { display:flex; align-items:center; height:116rpx; padding-right:28rpx; border-bottom:1rpx solid #eeeeee; box-sizing:border-box; }
.menu-icon { width:42rpx; height:42rpx; margin-right:22rpx; flex-shrink:0; }
.menu-label { flex:1; font-size:30rpx; color:#111; }
.menu-arrow { color:#c8c8c8; font-size:50rpx; line-height:1; font-weight:200; }
.menu-result { padding:1rpx 0 16rpx; background:#f5f5f5; }
.fav-item,.lead-item { margin:16rpx 20rpx; padding:24rpx; background:#fff; border-radius:12rpx; display:flex; justify-content:space-between; align-items:center; }
.name { font-size:28rpx; font-weight:bold; }
.tags { font-size:24rpx; color:#999; }
.status { font-size:24rpx; color:#1a73e8; }
.empty { text-align:center; padding:80rpx; color:#ccc; font-size:28rpx; }
.login-box { display:flex; flex:1; flex-direction:column; align-items:center; justify-content:center; min-height:0; }
.login-title { color:#172554; font-size:38rpx; font-weight:600; }
.login-tip { margin-top:18rpx; color:#687386; font-size:27rpx; }
.login-btn { width:480rpx; height:88rpx; line-height:88rpx; margin:48rpx 0 0; padding:0; border-radius:44rpx; background:#287fae; color:#fff; font-size:31rpx; }
.login-btn::after { border:0; }
.login-privacy { width:520rpx; margin-top:22rpx; color:#929aa6; font-size:22rpx; line-height:1.6; text-align:center; }
.consult-image-mask { position:fixed; inset:0; z-index:300; background:rgba(0,0,0,.62); }
.consult-image-popup { position:fixed; top:50%; left:50%; z-index:301; width:540rpx; transform:translate(-50%,-50%); }
.consult-image { width:100%; display:block; border-radius:24rpx; }
.consult-image-close { position:absolute; top:-66rpx; right:-4rpx; z-index:1; width:54rpx; height:54rpx; display:flex; align-items:center; justify-content:center; color:#fff; background:rgba(30,30,30,.72); border:2rpx solid rgba(255,255,255,.7); border-radius:50%; font-size:45rpx; line-height:1; font-weight:200; }

/* 品牌页脚 */
.brand-footer { position:relative; overflow:hidden; flex-shrink:0; margin-top:auto; padding:12rpx 28rpx calc(200rpx + env(safe-area-inset-bottom)); background:#f5f5f5; text-align:center; }
.brand-footer-logo { display:block; width:330rpx; height:auto; margin:0 auto; }
.brand-footer-book { position:relative; width:330rpx; height:30rpx; margin:-8rpx auto 0; }
.brand-footer-book view { position:absolute; bottom:5rpx; width:146rpx; height:30rpx; border-bottom:3rpx solid #c6e0ec; }
.brand-footer-book view:first-child { left:0; border-radius:0 0 100% 0; transform:skewY(8deg); }
.brand-footer-book view:nth-child(2) { right:0; border-radius:0 0 0 100%; transform:skewY(-8deg); }
.brand-footer-slogan { display:block; margin-top:-13rpx; color:#0f3460; background:linear-gradient(90deg,#0f3460 0%,#2c6292 50%,#0f3460 100%); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; font-family:Georgia,serif; font-size:27rpx; line-height:38rpx; font-style:italic; font-weight:600; letter-spacing:1rpx; }
.brand-footer-tags { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; margin-top:8rpx; color:#8097a3; font-size:20rpx; letter-spacing:1rpx; }
.brand-footer-tags i { margin:0 9rpx; color:#c99b36; font-style:normal; }
.beian-footer { display:flex; justify-content:center; align-items:center; flex-wrap:wrap; gap:10rpx 26rpx; margin-top:24rpx; padding:18rpx 16rpx calc(18rpx + env(safe-area-inset-bottom)); color:#666; font-size:20rpx; }
.beian-link { display:inline-flex; align-items:center; gap:7rpx; color:inherit; }
.beian-link image { width:36rpx; height:40rpx; object-fit:contain; }
