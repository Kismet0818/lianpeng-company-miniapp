page{background:#f4f7f9;color:#202124}
.page{min-height:100vh;padding-bottom:36rpx}

.filter-bar{position:sticky;top:0;z-index:20;height:92rpx;display:flex;align-items:center;padding:0 18rpx;background:#fff;border-bottom:1rpx solid #e5edf1;box-sizing:border-box}
.filter-picker{min-width:0;flex:1}
.filter-item{height:92rpx;display:flex;align-items:center;justify-content:center;color:#394850;font-size:27rpx}
.filter-item text:first-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.arrow{margin-left:10rpx;color:#64a8cd;font-size:18rpx}
.filter-line{width:1rpx;height:32rpx;background:#dce8ed}

.open-list{padding:20rpx 20rpx 30rpx}
.open-card{display:flex;margin-bottom:18rpx;padding:24rpx 20rpx;background:#fff;border:1rpx solid #dcebf2;border-top:6rpx solid #64a8cd;border-radius:18rpx;box-shadow:0 6rpx 18rpx rgba(49,108,139,.08);box-sizing:border-box}

.logo-wrap{width:172rpx;height:154rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-right:20rpx;padding:8rpx;overflow:hidden;border:1rpx solid #dce8ed;border-radius:14rpx;background:#f8fbfc;box-sizing:border-box}
.school-logo{width:100%;height:100%;border-radius:8rpx}
.logo-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#fff;background:#64a8cd;border-radius:8rpx;font-size:48rpx;font-weight:700}

.card-info{min-width:0;flex:1}
.school-name{display:block;color:#17242b;font-size:30rpx;line-height:42rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.address-row{display:flex;align-items:flex-start;margin-top:8rpx;color:#859198;font-size:22rpx;line-height:31rpx}
.address-row image{width:24rpx;height:24rpx;margin:3rpx 7rpx 0 0;flex-shrink:0}
.address-row text{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.info-row{display:flex;margin-top:7rpx;color:#526169;font-size:23rpx;line-height:32rpx}
.info-row text:last-child{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.info-label{flex-shrink:0;color:#89969d}

.reserve-link{height:42rpx;display:flex;align-items:center;justify-content:space-between;margin-top:12rpx;padding-left:13rpx;color:#4d92bb;background:#eef7fb;border-radius:22rpx;font-size:21rpx;white-space:nowrap;box-sizing:border-box}
.reserve-link text{height:42rpx;display:flex;align-items:center;padding:0 12rpx;color:#fff;background:#4d92bb;border-radius:22rpx;box-sizing:border-box}

.loading,.empty{padding:150rpx 20rpx;text-align:center;color:#91a0a8;font-size:26rpx}
.empty{display:flex;flex-direction:column;align-items:center}
.empty-icon{width:86rpx;height:86rpx;display:flex;align-items:center;justify-content:center;margin-bottom:20rpx;color:#fff;background:#64a8cd;border-radius:50%;font-size:34rpx}
