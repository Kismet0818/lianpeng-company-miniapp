page{min-height:100%;background:#F2F2F2;color:#444}.international-page{min-height:100vh;padding-bottom:calc(42rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.year-bar{height:104rpx;padding:0 44rpx;display:flex;border-bottom:1rpx solid #DDD}.year-tab{position:relative;display:flex;align-items:center;color:#F4512A;font-size:28rpx;font-weight:700}.year-tab::after{content:"";position:absolute;left:0;right:0;bottom:0;height:7rpx;background:#F4512A}
.filter-card{margin:36rpx 30rpx 30rpx;padding:20rpx 24rpx;display:flex;align-items:center;gap:12rpx;background:#FFF;border-radius:18rpx}.filter-symbol{width:46rpx;height:52rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7rpx}.filter-line{width:26rpx;height:2rpx;background:#6D7376}.filter-line.short{width:18rpx}.filter-option{height:54rpx;padding:0 18rpx;display:flex;align-items:center;gap:9rpx;color:#8A8F92;border:1rpx solid #DFE2E3;border-radius:10rpx;box-sizing:border-box;font-size:23rpx;font-weight:600}.filter-option .check-dot{display:none}.filter-option.active{color:#F4512A;border-color:#F6D8D0;background:#FCE7E1}.filter-option.active .check-dot{width:32rpx;height:32rpx;display:flex;align-items:center;justify-content:center;color:#FFF;background:#F45A34;border-radius:50%;font-size:21rpx}
.school-card{margin:0 30rpx;overflow:hidden;background:#FFF;border-radius:18rpx}.school-row{padding:42rpx 30rpx 32rpx;border-bottom:1rpx solid #DDD}.school-row:last-child{border-bottom:0}.school-name{display:block;color:#485158;font-size:28rpx;line-height:42rpx}.school-meta{margin-top:7rpx;display:flex;align-items:center;color:#858B8E;font-size:22rpx;line-height:32rpx}.school-meta text+text::before{content:"|";margin:0 16rpx;color:#C5C8CA}
.number-grid{margin-top:30rpx;display:grid;grid-template-columns:repeat(3,1fr)}.number-item{padding-left:36rpx;border-left:1rpx solid #D5D8DA}.number-item:first-child{padding-left:0;border-left:0}.number-label{display:block;color:#858B8E;font-size:21rpx}.number-value{display:block;margin-top:4rpx;color:#333A3E;font-size:34rpx;line-height:44rpx;font-weight:800}.number-value.unknown{color:#A0A5A8}
.page-status{min-height:430rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#A1A8AC;font-size:25rpx}.loading-ring{width:38rpx;height:38rpx;margin-bottom:20rpx;border:4rpx solid #DDE3E6;border-right-color:#64A8CD;border-radius:50%;animation:spin .8s linear infinite}.retry{margin-top:22rpx;padding:12rpx 30rpx;color:#4D92BB;border:1rpx solid rgba(100,168,205,.35);border-radius:10rpx}@keyframes spin{to{transform:rotate(360deg)}}
