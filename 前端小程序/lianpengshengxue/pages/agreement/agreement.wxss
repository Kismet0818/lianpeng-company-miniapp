page {
  background: #f5f6fa;
  height: 100%;
}

.agreement-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6fa;
}

/* 顶部 Tab */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #ebedf0;
  position: sticky;
  top: 0;
  z-index: 10;
  flex-shrink: 0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
  color: #7a7f85;
  position: relative;
  transition: color .2s;
}

.tab.active {
  color: #2d6cdf;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #2d6cdf;
}

/* 内容区 */
.content {
  flex: 1;
  padding: 28rpx 32rpx 60rpx;
  box-sizing: border-box;
  height: 0;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 12rpx;
}

.section-body {
  display: block;
  font-size: 26rpx;
  line-height: 44rpx;
  color: #4b5259;
  white-space: pre-line;
  word-break: break-all;
}

.footer-note {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a8adb3;
}
