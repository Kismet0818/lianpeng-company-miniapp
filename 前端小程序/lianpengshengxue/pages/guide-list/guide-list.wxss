page { background:#f4f6fa; color:#17181c; }
.page { min-height:100vh; }
.hero { position:relative; overflow:hidden; height:270rpx; padding:0 28rpx; box-sizing:border-box; background:linear-gradient(125deg,#e2f2f9 0%,#eff8fc 55%,#e8f4fa 100%); }
.hero-shape { position:absolute; border-radius:20rpx; background:rgba(255,255,255,.23); transform:rotate(-18deg); }
.shape-one { width:300rpx; height:160rpx; left:-70rpx; top:20rpx; }
.shape-two { width:280rpx; height:330rpx; right:-20rpx; bottom:-190rpx; }
.nav-row { position:relative; z-index:1; height:72rpx; display:flex; align-items:center; }
.back-button { width:66rpx; height:66rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; background:rgba(255,255,255,.72); }
.back-arrow { width:20rpx; height:20rpx; border-left:4rpx solid #18181c; border-bottom:4rpx solid #18181c; transform:rotate(45deg) translate(4rpx,-4rpx); }
.brand-row { position:absolute; z-index:1; left:30rpx; right:24rpx; bottom:40rpx; display:flex; align-items:center; }
.brand-icon-image { width:46rpx; height:46rpx; margin-right:12rpx; display:block; flex-shrink:0; }
.brand-title { color:#4d92bb; font-size:38rpx; line-height:52rpx; font-weight:700; white-space:nowrap; }
.guide-chat { height:58rpx; margin-left:auto; padding:0 14rpx 0 8rpx; display:flex; align-items:center; box-sizing:border-box; border-radius:32rpx; color:#762253; font-size:23rpx; background:rgba(255,255,255,.78); }
.guide-chat-icon { width:42rpx; height:42rpx; margin-right:7rpx; }
.guide-chat-arrow { margin-left:4rpx; font-size:28rpx; }
.category-tabs { height:86rpx; padding:14rpx 24rpx; box-sizing:border-box; white-space:nowrap; background:#fff; border-bottom:1rpx solid #ececf1; }
.category-tab { display:inline-flex; height:58rpx; margin-right:14rpx; padding:0 27rpx; align-items:center; justify-content:center; box-sizing:border-box; border:1rpx solid #d3d4da; border-radius:8rpx; color:#686970; font-size:25rpx; background:#fafbfc; }
.category-tab.active { color:#fff; border-color:#64a8cd; background:linear-gradient(135deg,#4d92bb,#64a8cd); }
.guide-groups { padding:20rpx 28rpx 50rpx; }
.guide-group { margin-bottom:32rpx; }
.group-title { display:block; margin-bottom:18rpx; color:#111216; font-size:31rpx; line-height:44rpx; font-weight:500; }
.article-card { overflow:hidden; padding:0 28rpx; border-radius:20rpx; background:#fff; }
.article-row { min-height:116rpx; display:flex; align-items:center; border-bottom:1rpx solid #eff0f4; }
.article-row:last-child { border-bottom:0; }
.article-icon-box { width:66rpx; height:66rpx; margin-right:24rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; border:5rpx solid #eef8fc; border-radius:16rpx; box-sizing:border-box; }
.article-icon-image { width:42rpx; height:42rpx; display:block; }
.article-title { flex:1; padding:20rpx 0; color:#17181c; font-size:27rpx; line-height:39rpx; }
.article-arrow { margin-left:12rpx; color:#c1c1ca; font-size:30rpx; }
.group-empty { padding:60rpx 0; color:#a0a1aa; font-size:24rpx; text-align:center; }
.status { min-height:420rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#9798a1; font-size:25rpx; }
.loading-dot { width:34rpx; height:34rpx; margin-bottom:18rpx; border:5rpx solid #d9edf6; border-top-color:#64a8cd; border-radius:50%; animation:spin .8s linear infinite; }
.retry { margin-top:24rpx; padding:14rpx 34rpx; color:#fff; border-radius:30rpx; background:linear-gradient(135deg,#4d92bb,#64a8cd); }
@keyframes spin { to { transform:rotate(360deg); } }
.qr-mask { position:fixed; inset:0; z-index:300; background:rgba(0,0,0,.62); }
.qr-popup { position:fixed; top:50%; left:50%; z-index:301; width:540rpx; transform:translate(-50%,-50%); }
.qr-img { width:100%; display:block; border-radius:24rpx; }
.qr-close { position:absolute; top:-66rpx; right:-4rpx; z-index:1; width:54rpx; height:54rpx; display:flex; align-items:center; justify-content:center; color:#fff; background:rgba(30,30,30,.72); border:2rpx solid rgba(255,255,255,.7); border-radius:50%; font-size:45rpx; line-height:1; font-weight:200; }
