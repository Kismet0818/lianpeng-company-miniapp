page { min-height:100%; background:#F4F8FA; color:#405D6D; }
.blessing-page { min-height:100vh; padding:24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.page-head { position:relative; padding:34rpx 32rpx; overflow:hidden; color:#fff; background:linear-gradient(135deg,#4D92BB 0%,#64A8CD 55%,#91C9E3 100%); border-radius:20rpx; }
.page-title,.page-subtitle { display:block; }
.page-title { font-size:38rpx; line-height:54rpx; font-weight:800; }
.page-subtitle { margin-top:8rpx; color:rgba(255,255,255,.82); font-size:24rpx; }
.page-total { position:absolute; right:30rpx; top:42rpx; color:rgba(255,255,255,.9); font-size:23rpx; }
.blessing-list { margin-top:24rpx; overflow:hidden; background:#fff; border:1rpx solid rgba(100,168,205,.16); border-radius:20rpx; }
.blessing-item { display:flex; padding:28rpx 26rpx; border-bottom:1rpx solid #E9EEF1; }
.blessing-item:last-child { border-bottom:0; }
.avatar { width:64rpx; height:64rpx; margin-right:18rpx; flex-shrink:0; border-radius:50%; background:#E9EEF1; }
.avatar-empty { display:flex; align-items:center; justify-content:center; color:#5D7D8E; font-size:25rpx; }
.item-main { min-width:0; flex:1; }
.item-meta { display:flex; align-items:center; justify-content:space-between; }
.nickname { color:#24485D; font-size:26rpx; font-weight:700; }
.time { margin-left:16rpx; color:#9AABB4; font-size:20rpx; }
.content { display:block; margin-top:10rpx; color:#405D6D; font-size:26rpx; line-height:42rpx; word-break:break-all; }
.loading,.empty,.end { padding:52rpx 0; color:#8AA0AD; font-size:23rpx; text-align:center; }
.end { padding:32rpx 0 8rpx; }
