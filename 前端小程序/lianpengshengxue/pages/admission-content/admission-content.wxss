page{background:#f7f7f7;color:#262626}.page{min-height:100vh;padding-bottom:40rpx}.topbar{position:relative;display:flex;align-items:center;justify-content:center;background:#fff;border-bottom:1rpx solid #f0f0f0;box-sizing:border-box}.nav-title{position:absolute;left:120rpx;right:120rpx;overflow:hidden;font-size:34rpx;line-height:46rpx;font-weight:700;text-align:center;text-overflow:ellipsis;white-space:nowrap}.back-button{position:absolute;left:8rpx;width:104rpx;padding:0;border:0;background:transparent;display:flex;align-items:center;justify-content:center;z-index:5}.back-button:active{opacity:.55}.back-arrow{width:22rpx;height:22rpx;border-left:4rpx solid #222;border-bottom:4rpx solid #222;transform:rotate(45deg)}.hero{padding:26rpx 28rpx 30rpx;background:#fff}.hero-title{display:block;font-size:42rpx;line-height:58rpx;font-weight:700}.hero-sub{display:block;margin-top:8rpx;color:#888;font-size:24rpx}.tabs{display:flex;gap:14rpx;overflow:hidden;background:#fff;padding:22rpx 28rpx 20rpx;border-top:8rpx solid #f7f7f7}.tab{flex:0 0 auto;padding:12rpx 28rpx;color:#4d5960;border-radius:30rpx;background:#f6f7f8;font-size:25rpx}.tab.active{color:#fff;background:#ff2745}.list{padding:14rpx 28rpx}.count{display:block;color:#a1a1a1;font-size:23rpx;margin:12rpx 0}.card{position:relative;display:flex;gap:20rpx;margin:0 -28rpx;padding:26rpx 28rpx;border-bottom:1rpx solid #ededed;background:#fff}.card-copy{min-width:0;flex:1}.title{display:-webkit-box;overflow:hidden;color:#363636;font-size:30rpx;line-height:42rpx;font-weight:700;-webkit-line-clamp:2;-webkit-box-orient:vertical}.summary{display:-webkit-box;overflow:hidden;margin-top:8rpx;color:#777;font-size:24rpx;line-height:36rpx;-webkit-line-clamp:2;-webkit-box-orient:vertical}.meta{display:block;margin-top:12rpx;color:#aaa;font-size:22rpx}.cover{width:176rpx;height:176rpx;flex:none;border-radius:8rpx;background:#ffe0e3}.status{text-align:center;padding:140rpx 30rpx;color:#89949b}.error text{display:block;margin-top:20rpx;color:#ff2745}
