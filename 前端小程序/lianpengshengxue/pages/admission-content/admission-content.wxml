<view class="page">
  <view class="topbar" style="height:{{navBarHeight}}px"><view class="back-button" style="top:{{menuTop}}px;height:{{menuHeight}}px" bindtap="goBack" aria-label="返回"><view class="back-arrow"></view></view><text class="nav-title" style="top:{{menuTop}}px;height:{{menuHeight}}px;line-height:{{menuHeight}}px">家长问答</text></view>
  <view class="hero"><text class="hero-title">家长问答</text><text class="hero-sub">上海家长入园、幼升小、小升初常见Q&A</text></view>
  <view class="tabs"><view wx:for="{{categories}}" wx:key="*this" class="tab {{item === category ? 'active' : ''}}" data-category="{{item}}" bindtap="selectCategory">{{item}}</view></view>
  <view wx:if="{{loading}}" class="status">正在加载内容...</view><view wx:elif="{{error}}" class="status error">{{error}}<text bindtap="load">重新加载</text></view><view wx:elif="{{articles.length}}" class="list"><text class="count">共找到{{total}}篇</text><view wx:for="{{articles}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openArticle"><view class="card-copy"><view class="title">{{item.title}}</view><text class="summary">{{item.summary || '围绕入园、幼升小、小升初等阶段，整理家长最关心的实用问题。'}}</text></view><image class="cover" src="{{item.coverImageUrl || '/assets/icons/zixun.png'}}" mode="aspectFill" /></view></view><view wx:else class="status">暂无问答内容</view>
</view>
