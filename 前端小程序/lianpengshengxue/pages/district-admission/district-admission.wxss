page { min-height:100%; background:#F4F8FA; color:#405D6D; }
.admission-page { min-height:100vh; padding:34rpx 24rpx calc(52rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.district-hero { min-height:158rpx; padding:0 22rpx; display:flex; align-items:center; justify-content:space-between; box-sizing:border-box; }
.district-title { display:block; color:#24485D; font-size:64rpx; line-height:78rpx; font-weight:800; letter-spacing:2rpx; }
.district-eyebrow { display:block; margin-top:4rpx; color:#8AA0AD; font-size:17rpx; line-height:26rpx; letter-spacing:3rpx; }
.hero-chart-icon { display:block; width:180rpx; height:142rpx; flex-shrink:0; }
.brand-divider { height:7rpx; margin-bottom:0; background:linear-gradient(90deg,#4D92BB,#64A8CD); }
.plan-card,.query-section { background:#fff; border:1rpx solid rgba(100,168,205,.16); border-radius:20rpx; }
.plan-card { padding:42rpx 38rpx 34rpx; }
.card-heading-row { display:flex; align-items:center; justify-content:space-between; }
.card-title,.query-title { color:#24485D; font-size:38rpx; line-height:52rpx; font-weight:700; }
.data-status { padding:5rpx 12rpx; color:#4D92BB; background:rgba(100,168,205,.10); border-radius:14rpx; font-size:19rpx; }
.table-head { height:70rpx; margin-top:14rpx; display:flex; align-items:center; border-bottom:1rpx solid #dfe7eb; color:#405D6D; font-size:24rpx; font-weight:500; text-align:center; }
.table-head text:first-child { width:48%; text-align:left; }.table-head text:nth-child(2),.table-head text:nth-child(3) { width:26%; text-align:left; }
.plan-row { min-height:72rpx; display:flex; align-items:center; font-size:26rpx; }
.plan-label { width:48%; display:flex; align-items:center; color:#405D6D; white-space:nowrap; }
.label-dot { width:9rpx; height:9rpx; margin-right:16rpx; background:#4D92BB; }
.plan-value { width:26%; color:#24485D; font-weight:700; text-align:left; white-space:nowrap; }
.plan-value text:last-child { color:#718996; font-size:21rpx; }
.plan-change { width:26%; color:#f06464; font-weight:700; text-align:left; white-space:nowrap; }
.plan-change.change-down { color:#19a96b; }
.total-row { min-height:84rpx; margin-top:10rpx; padding-top:18rpx; display:flex; align-items:center; border-top:1rpx solid #dfe7eb; color:#405D6D; font-size:26rpx; }
.total-row > text:first-child { width:48%; padding-left:25rpx; box-sizing:border-box; }.total-value { width:26%; color:#24485D; font-weight:800; text-align:left; }
.query-section { margin-top:26rpx; padding:44rpx 32rpx 42rpx; }
.query-title { display:block; margin-left:8rpx; }
.query-grid { display:flex; gap:20rpx; margin-top:32rpx; }
.query-card { height:190rpx; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#F4F8FA; border:1rpx solid rgba(100,168,205,.18); border-radius:14rpx; box-sizing:border-box; }
.query-card-active { background:rgba(100,168,205,.10); transform:scale(.985); }
.query-mark { width:62rpx; height:62rpx; margin-bottom:16rpx; display:flex; align-items:center; justify-content:center; }
.query-icon { display:block; width:54rpx; height:54rpx; }
.query-icon-school { width:60rpx; height:60rpx; }
.query-card text { color:#667680; font-size:36rpx; line-height:50rpx; font-weight:700; white-space:nowrap; }
.query-card .query-label-compact { font-size:30rpx; }
.independent-section { margin-top:42rpx; padding:0 10rpx; }
.independent-heading { display:flex; align-items:center; color:#334A57; font-size:34rpx; line-height:48rpx; font-weight:700; }
.independent-heading-icon { display:block; width:40rpx; height:40rpx; margin-right:14rpx; flex-shrink:0; }
.independent-list { margin:24rpx 0 0 48rpx; }
.independent-row { min-height:98rpx; padding:18rpx 0; display:flex; align-items:center; border-bottom:1rpx solid #DFE4E7; box-sizing:border-box; }
.independent-row-link { transition:background-color 160ms ease; }
.independent-row-active { background:#F5F8FA; }
.independent-text { min-width:0; flex:1; color:#405D6D; font-size:27rpx; line-height:39rpx; }
.independent-arrow { width:42rpx; margin-left:12rpx; flex-shrink:0; color:#B8C0C4; font-size:52rpx; line-height:1; text-align:right; font-weight:300; }
.catalog-section { margin-top:26rpx; padding:44rpx 20rpx 20rpx; overflow:hidden; background:#fff; border:1rpx solid rgba(100,168,205,.16); border-radius:20rpx; }
.catalog-title { display:block; margin-left:12rpx; color:#24485D; font-size:38rpx; line-height:52rpx; font-weight:700; }
.catalog-tabs { height:80rpx; margin:34rpx 0 24rpx; padding:8rpx; display:flex; align-items:stretch; background:#505050; border-radius:18rpx; box-sizing:border-box; }
.catalog-tab { min-width:0; flex:1; display:flex; align-items:center; justify-content:center; color:#fff; border-radius:10rpx; font-size:25rpx; line-height:34rpx; font-weight:700; white-space:nowrap; }
.catalog-tab.active { color:#3D4145; background:#fff; }
.letter-scroll { width:100%; height:64rpx; margin-bottom:4rpx; white-space:nowrap; }
.letter-list { height:64rpx; display:inline-flex; align-items:center; gap:10rpx; padding:0 8rpx; box-sizing:border-box; }
.letter-item { width:48rpx; height:48rpx; display:flex; align-items:center; justify-content:center; color:#4D7184; background:#F1F5F7; border:1rpx solid #DFE8EC; border-radius:10rpx; box-sizing:border-box; font-size:23rpx; font-weight:700; }
.letter-item:active { color:#fff; background:#64A8CD; border-color:#64A8CD; }
.catalog-list { padding:0 0 4rpx; }.catalog-group { margin-top:22rpx; }
.initial-row { height:68rpx; padding:0 10rpx; display:flex; align-items:center; border-bottom:1rpx solid #DFE3E5; }
.initial-row text { min-width:42rpx; height:42rpx; padding:0 10rpx; display:flex; align-items:center; justify-content:center; color:#40515A; background:#F1F1F1; border-radius:9rpx; box-sizing:border-box; font-size:25rpx; font-weight:800; }
.catalog-school { min-height:116rpx; padding:18rpx 10rpx; display:flex; align-items:center; border-bottom:1rpx solid #DFE3E5; box-sizing:border-box; }
.catalog-logo { width:62rpx; height:62rpx; margin-right:18rpx; flex-shrink:0; border-radius:50%; background:#F4F6F7; }
.catalog-info { min-width:0; flex:1; }.catalog-name { display:block; overflow:hidden; color:#30434D; font-size:27rpx; line-height:39rpx; text-overflow:ellipsis; white-space:nowrap; }
.catalog-meta { margin-top:3rpx; display:flex; align-items:center; overflow:hidden; color:#82919A; font-size:21rpx; line-height:30rpx; white-space:nowrap; }
.catalog-meta text { flex-shrink:0; }.catalog-meta text + text::before { content:"·"; margin:0 10rpx; color:#B4BDC2; }.catalog-code { color:#8A969D; font-weight:700; }
.catalog-arrow { margin-left:12rpx; flex-shrink:0; color:#B5BCC0; font-size:54rpx; line-height:1; font-weight:300; }
.catalog-empty { min-height:210rpx; display:flex; align-items:center; justify-content:center; color:#9AA8AF; font-size:24rpx; }
