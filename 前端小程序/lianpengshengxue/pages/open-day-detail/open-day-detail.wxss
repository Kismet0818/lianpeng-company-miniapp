page{background:#f4f7f9;color:#202124}
.page{min-height:100vh;padding:20rpx 0 56rpx;box-sizing:border-box}
.loading,.empty{padding:180rpx 20rpx;text-align:center;color:#91a0a8;font-size:26rpx}

.school-hero{margin:0 18rpx;padding:26rpx 24rpx 24rpx;background:#fff;border:1rpx solid #dcebf2;border-top:6rpx solid #64a8cd;border-radius:20rpx;box-shadow:0 8rpx 24rpx rgba(41,100,132,.09);box-sizing:border-box}
.hero-main{display:flex}
.hero-logo-wrap{width:166rpx;height:166rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-right:22rpx;padding:8rpx;overflow:hidden;background:#f8fbfc;border:1rpx solid #dce8ed;border-radius:15rpx;box-sizing:border-box}
.hero-logo{width:100%;height:100%;border-radius:8rpx}
.hero-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#fff;background:#64a8cd;border-radius:8rpx;font-size:54rpx;font-weight:700}
.hero-info{min-width:0;flex:1;padding-top:2rpx}
.hero-name{display:block;color:#17242b;font-size:34rpx;line-height:46rpx;font-weight:700}
.hero-stage{display:inline-block;margin-top:12rpx;padding:5rpx 13rpx;color:#527180;background:#eef6f9;border-radius:18rpx;font-size:23rpx;line-height:30rpx}
.hero-curriculum{display:-webkit-box;margin-top:10rpx;overflow:hidden;color:#4d92bb;font-size:24rpx;line-height:34rpx;font-weight:500;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.hero-desc{display:block;margin-top:24rpx;padding:20rpx;color:#5e6c73;background:#f7fafb;border-radius:14rpx;font-size:27rpx;line-height:1.75}
.hero-address{display:flex;align-items:flex-start;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #e8f0f3;color:#46565e;font-size:25rpx;line-height:36rpx}
.hero-address image{width:31rpx;height:31rpx;margin:2rpx 10rpx 0 0;flex-shrink:0}
.hero-address>text{min-width:0;flex:1}
.copy-btn{margin-left:16rpx;padding:5rpx 20rpx;flex-shrink:0;color:#4d92bb;background:#eaf5fa;border:1rpx solid #d4eaf4;border-radius:24rpx}

.month-section{margin:20rpx 18rpx 0;padding:26rpx 0 24rpx;background:#fff;border:1rpx solid #e3edf2;border-radius:20rpx;box-shadow:0 6rpx 18rpx rgba(49,108,139,.06)}
.section-title{display:flex;align-items:center;padding:0 22rpx;color:#26373f;font-size:31rpx;line-height:44rpx;font-weight:600}
.title-bar{width:8rpx;height:34rpx;margin-right:11rpx;border-radius:4rpx;background:#64a8cd}
.month-scroll{width:100%;margin-top:22rpx;white-space:nowrap}
.month-list{display:inline-flex;padding:0 22rpx}
.month-card{width:202rpx;height:142rpx;display:flex;align-items:baseline;justify-content:center;align-content:center;flex-wrap:wrap;margin-right:16rpx;color:#284a5b;background:#eef7fb;border:1rpx solid #cfe5ef;border-radius:14rpx;box-sizing:border-box}
.month-card.disabled{color:#a4adb2;background:#f1f3f4;border-color:#e4e8ea}
.month-number{font-size:60rpx;line-height:68rpx;font-weight:600}
.month-unit{margin-left:5rpx;font-size:24rpx}
.month-status{width:100%;margin-top:4rpx;color:#4d92bb;font-size:24rpx;text-align:center}
.month-card.disabled .month-status{color:#a4adb2}
.month-tip{display:block;margin:18rpx 22rpx 0;color:#94a0a6;font-size:22rpx}

.recommend-section{margin:20rpx 18rpx 0;overflow:hidden;background:#fff;border:1rpx solid #e3edf2;border-radius:20rpx;box-shadow:0 6rpx 18rpx rgba(49,108,139,.06)}
.recommend-tabs{display:flex;padding:20rpx;background:#f8fbfc}
.recommend-tab{height:68rpx;display:flex;align-items:center;justify-content:center;flex:1;color:#4d92bb;background:#fff;border:1rpx solid #64a8cd;font-size:28rpx;box-sizing:border-box}
.recommend-tab:first-child{border-radius:34rpx 0 0 34rpx}
.recommend-tab:last-child{border-radius:0 34rpx 34rpx 0}
.recommend-tab.active{color:#fff;background:#4d92bb;border-color:#4d92bb;font-weight:600}
.recommend-item{min-height:86rpx;display:flex;align-items:center;padding:0 24rpx;border-top:1rpx solid #edf2f4;color:#34454d;font-size:26rpx;line-height:36rpx;box-sizing:border-box}
.recommend-item text:first-child{min-width:0;flex:1}
.recommend-arrow{margin-left:14rpx;color:#64a8cd;font-size:40rpx}

.guide-section{margin:20rpx 16rpx 30rpx;padding:22rpx 18rpx 24rpx;background:#fff;border-radius:18rpx;box-shadow:0 4rpx 18rpx rgba(49,39,92,.05)}
.guide-title-row{display:flex;align-items:center;gap:10rpx;margin-bottom:22rpx}
.guide-bar{width:8rpx;height:34rpx;background:linear-gradient(180deg,#91c9e3,#64a8cd);border-radius:2rpx}
.guide-title{font-size:32rpx;font-weight:500;color:#171717}
.guide-timeline{position:relative;padding-left:54rpx}
.guide-timeline::before{content:"";position:absolute;left:21rpx;top:24rpx;bottom:24rpx;border-left:2rpx dashed #c9e2ee}
.guide-step{position:relative;margin-bottom:24rpx}
.guide-step:last-child{margin-bottom:0}
.step-node-row{min-height:46rpx;display:flex;align-items:center}
.step-dot{position:absolute;left:-54rpx;top:0;width:44rpx;height:44rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:linear-gradient(135deg,#4d92bb,#64a8cd);box-shadow:0 4rpx 10rpx rgba(77,146,187,.2);z-index:1}
.step-icon-placeholder{width:24rpx;height:24rpx;border-radius:6rpx;background:rgba(255,255,255,.9)}
.step-icon-image{width:46rpx;height:46rpx;display:block;filter:brightness(0) invert(1)}
.step-header{flex:1;display:flex;align-items:baseline;gap:12rpx;min-width:0}
.step-title{font-size:29rpx;line-height:42rpx;font-weight:500;color:#27252b;white-space:nowrap}
.step-sub{font-size:21rpx;line-height:32rpx;color:#8f8b94;white-space:nowrap}
.step-menu-card{display:flex;margin-top:14rpx;padding:24rpx 8rpx 22rpx;background:linear-gradient(145deg,#f5fbfe,#edf7fb);border-radius:20rpx}
.step-menu-item{width:25%;display:flex;flex-direction:column;align-items:center;text-align:center}
.menu-icon-placeholder{width:42rpx;height:42rpx;margin-bottom:12rpx;border-radius:10rpx;background:#91c9e3}
.menu-icon-image{width:42rpx;height:42rpx;margin-bottom:12rpx;display:block;filter:hue-rotate(310deg) saturate(.72) brightness(1.08)}
.menu-text{font-size:23rpx;line-height:34rpx;color:#17161a;white-space:nowrap}

.footer-brand{margin:20rpx 24rpx;padding:46rpx 36rpx 36rpx;background:#fff;border:1rpx solid #e0ebf0;border-radius:22rpx;text-align:center}
.footer-logo{display:block;color:#344c58;font-size:42rpx;font-weight:800;letter-spacing:6rpx}
.footer-slogan{display:block;margin:14rpx 0 26rpx;color:#4d92bb;font-family:Georgia,serif;font-size:23rpx;font-weight:300;letter-spacing:2rpx}
.footer-tags{color:#a1aaaf;font-size:21rpx;letter-spacing:4rpx;line-height:2}

.back-top{position:fixed;right:20rpx;bottom:38rpx;z-index:80;width:82rpx;height:82rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#64747c;background:rgba(255,255,255,.95);border:1rpx solid #d9e8ef;border-radius:50%;box-shadow:0 5rpx 16rpx rgba(49,108,139,.12);font-size:19rpx}
.back-top text:first-child{color:#4d92bb;font-size:34rpx;line-height:28rpx}

.reserve-mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:200;background:rgba(20,37,46,.46)}
.reserve-popup{position:fixed;left:0;right:0;bottom:0;z-index:201;height:82vh;display:flex;flex-direction:column;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:#fff;border-radius:34rpx 34rpx 0 0;box-sizing:border-box}
.popup-header{position:relative;height:66rpx;display:flex;align-items:flex-start;justify-content:center;flex-shrink:0}
.popup-title{color:#20333c;font-size:36rpx;line-height:50rpx;font-weight:600}
.popup-close{position:absolute;right:0;top:-4rpx;width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;color:#fff;background:#91a2aa;border-radius:50%;font-size:48rpx;line-height:48rpx}
.popup-scroll{min-height:0;flex:1}
.selected-school{margin:8rpx 0 12rpx;padding:18rpx 22rpx;color:#4d92bb;background:#eef7fb;border:1rpx solid #d9ecf4;border-radius:12rpx;font-size:26rpx;text-align:center}
.form-intro{height:72rpx;display:flex;align-items:center;color:#46575f;font-size:27rpx}
.form-intro view{width:8rpx;height:32rpx;margin-right:10rpx;background:#64a8cd;border-radius:4rpx}
.form-field{position:relative;height:104rpx;display:flex;align-items:center;border-bottom:1rpx solid #e4ecef}
.required{position:absolute;left:0;top:20rpx;color:#ef5b5b;font-size:26rpx}
.field-label{width:180rpx;padding-left:20rpx;box-sizing:border-box;color:#34454d;font-size:28rpx;flex-shrink:0}
.field-input{min-width:0;height:100%;flex:1;color:#333;font-size:27rpx}
.picker-text{min-width:0;flex:1;color:#a0aaaf;font-size:27rpx}
.picker-text.selected{color:#34454d}
.field-arrow{color:#64a8cd;font-size:46rpx}
.reserve-submit{width:calc(100% - 60rpx);height:84rpx;margin:22rpx auto 0;flex-shrink:0;color:#fff;background:#b6c1c6;border:0;border-radius:44rpx;font-size:31rpx;line-height:84rpx}
.reserve-submit::after{border:0}
.reserve-submit.ready{background:#4d92bb}

@media (max-width:340px){.hero-logo-wrap{width:138rpx;height:138rpx}.hero-name{font-size:31rpx}.month-card{width:184rpx}.step-sub{display:none}.menu-text{font-size:21rpx}}
