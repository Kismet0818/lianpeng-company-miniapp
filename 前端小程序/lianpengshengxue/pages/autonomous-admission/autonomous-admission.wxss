page{min-height:100%;background:#F2F2F2;color:#3F454A}.autonomous-page{min-height:100vh;padding-bottom:calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.year-tabs{height:104rpx;padding:0 42rpx;display:flex;border-bottom:1rpx solid #DFDFDF}.year-tab{position:relative;display:flex;align-items:center;justify-content:center;font-size:27rpx;font-weight:700;white-space:nowrap}.year-tab.active{color:#F4512A}.year-tab.active::after{content:"";position:absolute;left:0;right:0;bottom:0;height:7rpx;background:#F4512A}
.district-filter{margin:36rpx 26rpx 30rpx;padding:18rpx 16rpx;display:grid;grid-template-columns:repeat(7,1fr);gap:16rpx 10rpx;background:#fff;border-radius:18rpx}.district-option{height:54rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #DADDE0;border-radius:9rpx;font-size:22rpx;font-weight:600}.district-option.active{color:#F4512A;border-color:#F6D5CC;background:#FCE9E4}
.school-list{margin:0 26rpx;overflow:hidden;background:#fff;border-radius:18rpx}.school-item{padding:42rpx 30rpx 32rpx;border-bottom:1rpx solid #DCDCDC}.school-item:last-child{border-bottom:0}.school-name{display:block;color:#34464F;font-size:28rpx;line-height:42rpx}.school-meta{margin-top:6rpx;display:flex;color:#85939A;font-size:22rpx}.school-meta text+text::before{content:"|";margin:0 16rpx;color:#C3C8CB}
.quota-grid{margin-top:30rpx;display:grid;grid-template-columns:repeat(3,1fr)}.quota-item{min-width:0;padding-left:10rpx;border-right:1rpx solid #D7DADD}.quota-item:first-child{padding-left:0}.quota-item:last-child{border-right:0}.quota-label{display:block;color:#75858D;font-size:21rpx}.quota-item>view{margin-top:4rpx;display:flex;align-items:baseline}.quota-value{color:#253F4D;font-size:35rpx;font-weight:800}.quota-trend{margin-left:10rpx;color:#405D6D;font-size:21rpx}
.page-status{min-height:420rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#A1A9AD;font-size:25rpx}.loading-ring{width:38rpx;height:38rpx;margin-bottom:20rpx;border:4rpx solid #DDE3E6;border-right-color:#64A8CD;border-radius:50%;animation:spin .8s linear infinite}.retry{margin-top:22rpx;padding:12rpx 30rpx;color:#4D92BB;border:1rpx solid rgba(100,168,205,.35);border-radius:10rpx}@keyframes spin{to{transform:rotate(360deg)}}
@media screen and (max-width:340px){.district-filter{grid-template-columns:repeat(5,1fr)}.year-tabs{padding:0 18rpx}.year-tab{font-size:24rpx}}
