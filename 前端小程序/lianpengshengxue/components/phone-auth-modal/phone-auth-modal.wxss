.auth-mask{position:fixed;z-index:9999;inset:0;background:rgba(20,35,48,.18);display:flex;align-items:center;justify-content:center}.auth-dialog{width:86%;box-sizing:border-box;padding:30rpx 42rpx 24rpx;background:#fff;border-radius:28rpx;text-align:center;box-shadow:0 12rpx 50rpx rgba(0,0,0,.16)}.auth-title{margin-top:0;color:#202936;font-size:34rpx;font-weight:700}.auth-desc{margin-top:12rpx;color:#71808c;font-size:24rpx;line-height:1.45}.auth-button{display:block;width:100%;box-sizing:border-box;padding:0;margin:22rpx auto 0;height:70rpx;line-height:70rpx;text-align:center;border:0;border-radius:35rpx;color:#fff;background:linear-gradient(90deg,#3b9bc8,#267aaa);font-size:27rpx}.auth-button::after{border:0}.auth-cancel{margin-top:16rpx;color:#9aa3aa;font-size:23rpx}
