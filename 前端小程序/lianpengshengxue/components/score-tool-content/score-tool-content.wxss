page {
  min-height:100%;
  background:#F4F8FA;
  color:#405D6D;
}

.score-page {
  min-height:100vh;
  padding-bottom:calc(52rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
  background:#F4F8FA;
}

.hero {
  position:relative;
  overflow:hidden;
  height:264rpx;
  padding:30rpx 30rpx 62rpx;
  box-sizing:border-box;
  color:#fff;
  background:#64A8CD;
  border-radius:0;
}

.hero-content {
  position:relative;
  z-index:1;
}

.hero-label {
  display:inline-block;
  color:rgba(255,255,255,.84);
  font-size:21rpx;
  line-height:28rpx;
}

.hero-title {
  display:block;
  margin-top:10rpx;
  color:#fff;
  font-size:38rpx;
  line-height:52rpx;
  font-weight:700;
}

.hero-subtitle {
  display:block;
  margin-top:5rpx;
  color:rgba(255,255,255,.82);
  font-size:23rpx;
  line-height:34rpx;
}

.hero-meta { display:flex; margin-top:16rpx; }
.hero-meta text { margin-right:22rpx; color:rgba(255,255,255,.88); font-size:20rpx; line-height:30rpx; }

.district-panel {
  position:relative;
  z-index:2;
  margin:-42rpx 16rpx 0;
}

.search-box {
  height:94rpx;
  padding:0 30rpx;
  display:flex;
  align-items:center;
  box-sizing:border-box;
  background:#fff;
  border:1rpx solid rgba(100,168,205,.22);
  border-radius:18rpx;
  box-shadow:0 10rpx 28rpx rgba(50,104,135,.11);
  opacity:0;
  transform:translateY(18rpx);
  transition:opacity 350ms ease 80ms,transform 350ms cubic-bezier(.22,1,.36,1) 80ms;
}

.is-ready .reveal-search { opacity:1; transform:translateY(0); }

.search-icon {
  position:relative;
  width:25rpx;
  height:25rpx;
  margin-right:18rpx;
  border:4rpx solid #64A8CD;
  border-radius:50%;
  box-sizing:border-box;
}

.search-icon::after {
  content:"";
  position:absolute;
  right:-10rpx;
  bottom:-7rpx;
  width:12rpx;
  height:4rpx;
  border-radius:2rpx;
  background:#64A8CD;
  transform:rotate(45deg);
}

.search-input {
  min-width:0;
  height:94rpx;
  flex:1;
  color:#405D6D;
  font-size:27rpx;
}

.search-placeholder {
  color:#8AA0AD;
}

.section-heading {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:40rpx;
  padding:0 2rpx;
}

.section-title {
  color:#24485D;
  font-size:31rpx;
  line-height:44rpx;
  font-weight:700;
}

.section-count {
  color:#8AA0AD;
  font-size:21rpx;
  line-height:32rpx;
}

.district-grid {
  display:flex;
  flex-wrap:wrap;
  margin-top:22rpx;
  margin-right:-16rpx;
}

.district-item {
  width:calc(33.333% - 16rpx);
  min-width:0;
  height:120rpx;
  margin:0 16rpx 16rpx 0;
  padding:20rpx 17rpx;
  display:flex;
  align-items:center;
  box-sizing:border-box;
  background:#fff;
  border:1rpx solid rgba(100,168,205,.22);
  border-radius:16rpx;
  box-shadow:0 6rpx 18rpx rgba(50,104,135,.05);
  transition:transform 160ms ease, background-color 160ms ease;
  opacity:0;
  animation:district-in 330ms cubic-bezier(.22,1,.36,1) forwards;
}

.district-item-active {
  background:rgba(100,168,205,.10);
  transform:scale(.985);
}

.district-copy {
  min-width:0;
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.district-arrow {
  width:11rpx;
  height:11rpx;
  margin-left:6rpx;
  flex-shrink:0;
  border-top:3rpx solid #64A8CD;
  border-right:3rpx solid #64A8CD;
  transform:rotate(45deg);
}

.district-name {
  display:block;
  overflow:hidden;
  color:#24485D;
  font-size:26rpx;
  line-height:36rpx;
  font-weight:700;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.district-count {
  display:block;
  margin-top:4rpx;
  color:#8AA0AD;
  font-size:18rpx;
  line-height:27rpx;
  white-space:nowrap;
}

.empty-state {
  margin-top:20rpx;
  padding:70rpx 20rpx;
  color:#8AA0AD;
  background:#fff;
  border:1rpx solid rgba(100,168,205,.22);
  border-radius:16rpx;
  font-size:25rpx;
  text-align:center;
}

.empty-title,.empty-tip { display:block; }
.empty-title { color:#607785; font-size:27rpx; font-weight:600; }
.empty-tip { margin-top:10rpx; color:#9aabb5; font-size:22rpx; }

.reveal-list { opacity:0; transform:translateY(16rpx); transition:opacity 360ms ease 150ms,transform 360ms cubic-bezier(.22,1,.36,1) 150ms; }
.is-ready .reveal-list { opacity:1; transform:translateY(0); }
.is-ready .district-grid { opacity:1; }

.query-note { margin-top:32rpx; padding:28rpx; display:flex; align-items:flex-start; background:rgba(100,168,205,.09); border:1rpx solid rgba(100,168,205,.22); border-radius:16rpx; box-sizing:border-box; }
.blessing-wall { margin-top:32rpx; padding:28rpx 26rpx 22rpx; background:#fff; border-radius:20rpx; border:1rpx solid rgba(100,168,205,.18); box-shadow:0 8rpx 22rpx rgba(50,104,135,.06); box-sizing:border-box; }
.blessing-heading { display:flex; align-items:center; justify-content:space-between; padding-bottom:16rpx; border-bottom:5rpx solid #566269; }
.blessing-scroll { height:288rpx; }
.blessing-title { color:#344952; font-size:32rpx; line-height:44rpx; font-weight:800; }
.blessing-mark { color:#F4512A; font-size:21rpx; }
.blessing-line { min-height:72rpx; display:flex; align-items:center; color:#405D6D; font-size:25rpx; line-height:36rpx; white-space:nowrap; }
.blessing-avatar { width:42rpx; height:42rpx; margin-right:12rpx; display:flex; align-items:center; justify-content:center; color:#fff; background:linear-gradient(135deg,#91C9E3,#4D92BB); border-radius:50%; font-size:22rpx; font-weight:700; }
.blessing-nickname { max-width:170rpx; overflow:hidden; color:#344952; font-weight:800; text-overflow:ellipsis; }
.blessing-target { margin-left:10rpx; }
.blessing-school { margin-left:10rpx; overflow:hidden; color:#F4512A; font-weight:800; text-overflow:ellipsis; }
.blessing-empty { height:288rpx; display:flex; align-items:center; justify-content:center; color:#8AA0AD; font-size:23rpx; text-align:center; }
.content-module{margin-top:28rpx;padding:26rpx 26rpx 18rpx;background:#fff;border-radius:20rpx;border:1rpx solid rgba(100,168,205,.18)}.content-heading{display:flex;align-items:center;justify-content:space-between}.content-title{color:#344952;font-size:32rpx;font-weight:800}.year-tabs{display:flex;gap:10rpx}.year-tab{padding:10rpx 18rpx;background:#f0f1f2;border-radius:14rpx;color:#344952;font-size:24rpx}.year-tab.active{color:#f4512a;background:#fff0eb}.content-row,.tip-row{position:relative;display:flex;align-items:center;min-height:92rpx;border-bottom:1rpx solid #e4e4e4}.content-row:last-child,.tip-row:last-child{border-bottom:0}.content-icon,.tip-icon{width:36rpx;color:#999;font-size:28rpx}.content-row-title{flex:1;color:#405d6d;font-size:27rpx;line-height:38rpx}.content-cover{width:184rpx;height:108rpx;margin-left:12rpx;border-radius:10rpx}.more-entry{padding-top:18rpx;color:#f4512a;text-align:right;font-size:26rpx;font-weight:700}.more-entry text{display:inline-flex;width:38rpx;height:38rpx;margin-left:8rpx;align-items:center;justify-content:center;color:#fff;background:#f4512a;border-radius:50%;font-size:28rpx}
.info-icon { width:34rpx; height:34rpx; margin:2rpx 20rpx 0 0; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:#fff; background:#64A8CD; border-radius:50%; font-size:22rpx; font-family:Arial,sans-serif; font-weight:700; }
.note-copy { min-width:0; flex:1; }
.note-title { display:block; color:#24485D; font-size:27rpx; line-height:38rpx; font-weight:700; }
.note-text { display:block; margin-top:9rpx; color:#607785; font-size:22rpx; line-height:35rpx; }
.consult-entry { padding:28rpx 0 4rpx; display:flex; align-items:center; justify-content:center; color:#8AA0AD; font-size:22rpx; line-height:34rpx; }
.consult-link { margin-left:10rpx; color:#4D92BB; font-weight:600; }

@keyframes district-in { from { opacity:0; transform:translateY(14rpx); } to { opacity:1; transform:translateY(0); } }

.content-icon-image { width:42rpx !important; height:42rpx !important; max-width:42rpx !important; max-height:42rpx !important; flex:0 0 42rpx !important; margin-right:12rpx !important; }
